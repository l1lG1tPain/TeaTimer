}

async function saveTeaForm() {
  const v = id => (document.getElementById(id) || {}).value || '';
  const n = (id, def) => { const x = parseFloat(String(v(id)).replace(',', '.')); return isFinite(x) ? x : def; };
  const err = document.getElementById('tf-err');
  const fail = msg => { err.textContent = msg; err.hidden = false; };

  const name = v('tf-name').trim();
  if (!name) return fail('Введите название чая');
  let tmin = Math.round(n('tf-tmin', 90)), tmax = Math.round(n('tf-tmax', 95));
  if (tmin > tmax) [tmin, tmax] = [tmax, tmin];
  if (tmin < 60 || tmax > 100) return fail('Температура воды — от 60 до 100 °C');
  const ratio = n('tf-ratio', 5);
  if (ratio <= 0 || ratio > 15) return fail('Заварка — от 0.5 до 15 г на 100 мл');
  const maxInf = Math.round(n('tf-max', 7));
  if (maxInf < 1 || maxInf > 20) return fail('Проливов — от 1 до 20');
  const first = Math.round(n('tf-first', 20));
  if (first < 3 || first > 600) return fail('Первый пролив — от 3 до 600 секунд');
  const inc = Math.round(n('tf-inc', 5));
  if (inc < 0 || inc > 120) return fail('Прибавка — от 0 до 120 секунд');

  const old = state.teaForm.editId ? getTea(state.teaForm.editId) : null;
  const tea = Object.assign({}, old || {}, {
    id: old ? old.id : 'custom-' + generateId(),
    name_ru: name,
    name_en: v('tf-en').trim(),
    name_cn: v('tf-cn').trim(),
    category: state.teaForm.cat,
    temperature_min: tmin, temperature_max: tmax,
    gaiwan_ratio_g_per_100ml: ratio,
    rinse_recommended: state.teaForm.rinse,
    first_steep_seconds: first, steep_increment_seconds: inc, max_infusions: maxInf,
    tags: v('tf-tags').split(',').map(x => x.trim()).filter(Boolean),
    description_ru: v('tf-desc').trim(),
    is_custom: true,
    created_at: old ? old.created_at : new Date().toISOString()
  });
  await db.saveCustomTea(tea);
  await mergeCustomTeas();
  closeTeaSheet();
  if (state.currentScreen === 'tea-detail') renderTeaDetail(tea.id);
  else { state.searchQuery = ''; state.activeCategory = 'all'; navigate('tea-detail', { teaId: tea.id }); }
}

let _teaDeleteArm = null;
async function deleteCustomTeaConfirm(id, btn) {
  if (_teaDeleteArm !== id) {
    _teaDeleteArm = id;
    btn.textContent = 'Нажмите ещё раз — удалить чай';
    btn.classList.add('armed');
    setTimeout(() => { if (_teaDeleteArm === id) { _teaDeleteArm = null; if (btn.isConnected) { btn.textContent = 'Удалить чай'; btn.classList.remove('armed'); } } }, 3000);
    return;
  }
  _teaDeleteArm = null;
  await db.deleteCustomTea(id);
  TEAS = TEAS.filter(t => t.id !== id);
  navigate('catalog');
}

