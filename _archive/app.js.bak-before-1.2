// ============================================
// Pull-to-refresh: потянуть вниз и держать 1 секунду
// ============================================
const PTR = { HOLD_MS: 1000, THRESHOLD: 74, MAX: 104 };

function buildPtrIndicator() {
  if (document.getElementById('ptr')) return;
  const el = document.createElement('div');
  el.id = 'ptr';
  el.setAttribute('aria-hidden', 'true');
  el.innerHTML = `
    <div class="ptr-badge">
      <svg class="ptr-ring" viewBox="0 0 64 64"><circle class="ptr-ring-bg" cx="32" cy="32" r="29"/><circle class="ptr-ring-fg" id="ptr-ring" cx="32" cy="32" r="29" pathLength="100"/></svg>
      <svg class="ptr-cup" viewBox="0 0 48 48" fill="none">
        <defs><clipPath id="ptr-clip"><path d="M10 20h28v4a14 14 0 0 1-14 14h0A14 14 0 0 1 10 24z"/></clipPath></defs>
        <g clip-path="url(#ptr-clip)"><rect id="ptr-liquid" x="8" y="38" width="32" height="20" class="ptr-liquid"/></g>
        <path d="M10 20h28v4a14 14 0 0 1-14 14h0A14 14 0 0 1 10 24z" class="ptr-cup-line"/>
        <path d="M38 23h2.5a3.5 3.5 0 0 1 0 7H36" class="ptr-cup-line"/>
        <path class="ptr-wisp w1" d="M18 15c-2-2 2-3 0-6"/><path class="ptr-wisp w2" d="M24 15c-2-2 2-3 0-7"/><path class="ptr-wisp w3" d="M30 15c-2-2 2-3 0-6"/>
      </svg>
    </div>
    <span class="ptr-text" id="ptr-text"></span>`;
  document.body.appendChild(el);
}

function initPullToRefresh() {
  buildPtrIndicator();
  const el = document.getElementById('ptr');
  const ring = document.getElementById('ptr-ring');
  const liquid = document.getElementById('ptr-liquid');
  const label = document.getElementById('ptr-text');
  const app = document.getElementById('app');

  let startY = 0, startX = 0, scroller = null, armed = false, pulling = false;
  let dist = 0, holdStart = 0, raf = 0, done = false, busy = false, hapticStep = -1;

  const activeScroller = () => {
    if (state.currentScreen === 'timer' || document.getElementById('session-sheet')) return null;
    return document.querySelector('.screen.active');
  };

  const paint = (hold) => {
    const y = dist - 70;                                   // бейдж выезжает сверху
    el.style.transform = `translate3d(0, ${y}px, 0)`;
    el.style.opacity = Math.min(1, dist / 40);
    const pre = Math.min(1, dist / PTR.THRESHOLD);
    el.style.setProperty('--pre', pre.toFixed(3));
    ring.style.strokeDashoffset = String(100 - hold * 100);
    liquid.setAttribute('y', String(38 - hold * 22));       // чашка наполняется
    el.classList.toggle('ready', dist >= PTR.THRESHOLD);
    el.classList.toggle('done', done);
    if (done) label.textContent = 'Готово — обновляю';
    else if (dist < PTR.THRESHOLD) label.textContent = 'Потяните ниже';
    else label.textContent = `Держите… ещё ${Math.max(0, (PTR.HOLD_MS * (1 - hold) / 1000)).toFixed(1)} с`;
  };

  const tick = () => {
    if (!pulling || done) return;
    let hold = 0;
    if (dist >= PTR.THRESHOLD) {
      if (!holdStart) holdStart = performance.now();
      hold = Math.min(1, (performance.now() - holdStart) / PTR.HOLD_MS);
      // лёгкие «тики» вибрации по ходу удержания
      const step = Math.floor(hold * 4);
      if (step !== hapticStep && step > 0 && navigator.vibrate && state.settings?.vibration_enabled) { navigator.vibrate(6); }
      hapticStep = step;
      if (hold >= 1) { done = true; paint(1); trigger(); return; }
    } else { holdStart = 0; hapticStep = -1; }
    paint(hold);
    raf = requestAnimationFrame(tick);
  };

  const reset = () => {
    cancelAnimationFrame(raf);
    pulling = false; armed = false; holdStart = 0; hapticStep = -1;
    el.classList.add('settle');
    el.style.transform = 'translate3d(0,-90px,0)';
    el.style.opacity = '0';
    setTimeout(() => { el.classList.remove('settle', 'busy', 'done', 'ready'); dist = 0; done = false; busy = false; }, 320);
  };

  async function trigger() {
    busy = true;
    el.classList.add('busy');
    el.style.transform = 'translate3d(0, 18px, 0)';
    el.style.opacity = '1';
    if (navigator.vibrate && state.settings?.vibration_enabled) navigator.vibrate([18, 40, 30]);
    await refreshApp();
    reset();
  }

  app.addEventListener('touchstart', (e) => {
    if (busy || e.touches.length !== 1) return;
    if (e.target.closest && e.target.closest('.slider-hit, input, textarea, .t-tags, .today-chips, .scenario-row, .sheet, .segmented')) { armed = false; return; }   // ползунки и поля — не «потяни для обновления»
    scroller = activeScroller();
    if (!scroller || scroller.scrollTop > 0) { armed = false; return; }
    armed = true; pulling = false; done = false;
    startY = e.touches[0].clientY; startX = e.touches[0].clientX;
  }, { passive: true });

  app.addEventListener('touchmove', (e) => {
    if (!armed || busy) return;
    const t = e.touches[0];
    const dy = t.clientY - startY, dx = t.clientX - startX;
    if (!pulling) {
      if (dy < 8 || Math.abs(dx) > Math.abs(dy)) { if (dy < -4) armed = false; return; }
      if (scroller.scrollTop > 0) { armed = false; return; }
      pulling = true; el.classList.remove('settle');
      raf = requestAnimationFrame(tick);
    }
    if (e.cancelable) e.preventDefault();
    dist = Math.min(PTR.MAX, (dy - 8) * 0.55);
    if (dist < PTR.THRESHOLD) paint(0);                      // дальше рисует tick()
  }, { passive: false });

  const end = () => {
    if (!armed && !pulling) return;
    armed = false;
    if (pulling && !done && !busy) reset();
  };
  app.addEventListener('touchend', end, { passive: true });
  app.addEventListener('touchcancel', end, { passive: true });

  window.__ptrSim = { pull(d) { dist = d; pulling = true; armed = true; raf = requestAnimationFrame(tick); }, get done() { return done; } };
}

// Обновление: данные + проверка новой версии приложения
async function refreshApp() {
  const t0 = Date.now();
  try { await loadAppData(); } catch (e) { console.warn(e); }
  let online = navigator.onLine;
  if (online) {
    try { const r = await fetch('./sw.js?r=' + Date.now(), { cache: 'no-store' }); online = r.ok; } catch (e) { online = false; }
  }
  if (online) {
    try {
      const reg = 'serviceWorker' in navigator ? await navigator.serviceWorker.getRegistration() : null;
      if (reg) await reg.update();
      const keys = await caches.keys();
      await Promise.all(keys.filter(k => !k.includes('sounds')).map(k => caches.delete(k)));
    } catch (e) { console.warn(e); }
    await new Promise(r => setTimeout(r, Math.max(0, 500 - (Date.now() - t0))));
    location.reload();
    await new Promise(() => {});          // дальше страница перезагрузится
  } else {
    _renderTop();
  }
}

// Start when DOM ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}