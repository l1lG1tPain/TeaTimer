function renderTimer() {
  const container = document.getElementById('screen-timer');
  if (!container) return;

  const session = state.currentSession;
  if (!session) { navigate('home'); return; }

  const tea = getTea(session.tea_id);
  const cat = tea ? getCategory(tea.category) : CATEGORIES[0];
  const log = session.infusion_log;
  const currentIdx = log.findIndex(i => i.poured_at === null && !i.skipped);
  const currentInfusion = currentIdx >= 0 ? log[currentIdx] : null;

  if (!currentInfusion) {
    finishSession();
    return;
