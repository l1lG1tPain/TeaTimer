// «Вкусы и оценки»: любимые вкусовые теги, лучшие по оценке, расход заварки
function tasteStatsHtml(sessions) {
  const tagCount = {};
  sessions.forEach(s => (s.infusion_log || []).forEach(i => (i.tags || []).forEach(t => { tagCount[t] = (tagCount[t] || 0) + 1; })));
  const tags = Object.entries(tagCount).sort((a, b) => b[1] - a[1]).slice(0, 8);
  const byTea = {};
  sessions.filter(s => s.rating).forEach(s => {
    const k = s.tea_id; (byTea[k] ||= { id: s.tea_id, name: s.tea_name_snapshot, sum: 0, n: 0 });
    byTea[k].sum += s.rating; byTea[k].n++;
  });
  const best = Object.values(byTea).map(x => ({ ...x, avg: x.sum / x.n })).sort((a, b) => b.avg - a.avg || b.n - a.n).slice(0, 3);
  const grams = sessions.reduce((a, s) => a + (+s.grams || 0), 0);
  if (!tags.length && !best.length && !grams) return '';
  return `
  <section class="panel mt-16">
    <span class="overline">Вкусы и оценки</span>
    ${grams ? `<p class="ts-line"><b>${(Math.round(grams * 10) / 10).toString().replace('.', ',')} г</b> заварки за период</p>` : ''}
    ${tags.length ? `<div class="ts-tags">${tags.map(([t, n]) => `<span>${escapeHtml(t)} <em>${n}</em></span>`).join('')}</div>` : ''}
    ${best.length ? `<div class="ts-best">${best.map(b => `
      <div class="toptea" onclick="navigate('tea-detail',{teaId:'${b.id}'})">
        <span class="toptea-name">${escapeHtml(b.name)}</span>
        <span class="ts-star">★ ${b.avg.toFixed(1)}</span>
      </div>`).join('')}</div>` : ''}
  </section>`;
}

function renderHistory() {
  const container = document.getElementById('screen-history');
  if (!container) return;

  const period = state.historyPeriod || 'week';
  const all = state.sessions ? [...state.sessions].sort((a, b) => new Date(b.start_time) - new Date(a.start_time)) : [];

  const cutoff = new Date();
  if (period === 'week') cutoff.setDate(cutoff.getDate() - 6);
  else if (period === 'month') cutoff.setDate(cutoff.getDate() - 29);
  cutoff.setHours(0, 0, 0, 0);
  const sessions = period === 'all' ? all : all.filter(s => new Date(s.start_time) >= cutoff);

  // ---- Статистика периода ----
  const total = sessions.length;
  const totalMin = sessions.reduce((a, s) => a + sessionMinutes(s), 0);
  const totalPours = sessions.reduce((a, s) => a + sessionPours(s), 0);
  const rated = sessions.filter(s => s.rating);
  const avgRating = rated.length ? rated.reduce((a, s) => a + s.rating, 0) / rated.length : 0;
  const streak = calcStreak(all);

  // ---- График ----
  const buckets = buildBuckets(sessions, period);
  const maxN = Math.max(1, ...buckets.map(b => b.n));
  const dense = buckets.length > 12;
  const labelEvery = buckets.length > 12 ? 5 : 1;
  const chartHtml = buckets.map((b, i) => {
    const h = b.n ? Math.max(10, Math.round((b.n / maxN) * 100)) : 4;
    const showLabel = (buckets.length - 1 - i) % labelEvery === 0;
    return `
      <div class="hc-col ${b.cur ? 'cur' : ''} ${b.n ? '' : 'empty'}" title="${b.n} ${plural(b.n, 'чаепитие', 'чаепития', 'чаепитий')}">
        <span class="hc-val">${b.n && !dense ? b.n : ''}</span>
        <span class="hc-bar" style="height:${h}%"></span>
        <span class="hc-lab">${showLabel ? b.label : ''}</span>
      </div>`;
  }).join('');

  // ---- Сорта (по категориям) и любимые чаи ----
  const catCounts = {};
  const teaCounts = {};
  sessions.forEach(s => {
    const t = getTea(s.tea_id);
    const cid = t ? t.category : 'other';
    catCounts[cid] = (catCounts[cid] || 0) + 1;
    const k = s.tea_id + '|' + s.tea_name_snapshot;
    teaCounts[k] = (teaCounts[k] || 0) + 1;
  });
  const catList = Object.entries(catCounts).sort((a, b) => b[1] - a[1]).map(([id, n]) => {
    const c = CATEGORIES.find(x => x.id === id);
    return { id, n, name: c ? c.name_ru : 'Другое', color: c ? c.accent : '#B9AB88' };
  });
  const topTeas = Object.entries(teaCounts).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([k, n]) => {
    const [id, name] = k.split('|');
    const t = getTea(id);
    const c = t ? getCategory(t.category) : null;
    return { id, name, n, color: c ? c.accent : '#B9AB88' };
  });
  const topMax = topTeas.length ? topTeas[0].n : 1;

  // ---- Список по дням ----
  const groups = {};
  sessions.forEach(s => { (groups[dayKey(s.start_time)] ||= []).push(s); });

  const sessionRow = (s) => {
    const t = getTea(s.tea_id);
    const c = t ? getCategory(t.category) : null;
    const pours = sessionPours(s);
    const planned = (s.infusion_log || []).length;
    return `
      <button class="hrow" onclick="openSessionSheet('${s.id}')">
        <span class="gem" style="--c:${c ? c.accent : '#B9AB88'}"></span>
        <span class="hrow-main">
          <span class="hrow-name">${escapeHtml(s.tea_name_snapshot)}</span>
          <span class="hrow-meta">${hhmm(s.start_time)} · ${pours} из ${planned} пр · ${sessionMinutes(s)} мин</span>
        </span>
        ${s.rating ? starsHtml(s.rating, 'sm') : '<span class="hrow-rate">оценить</span>'}
      </button>`;
  };

  container.innerHTML = `
    <div class="screen-content">
      <h1 class="page-title">История</h1>

      <div class="segmented mb-16">
        <button class="segment ${period === 'week' ? 'active' : ''}" onclick="setHistoryPeriod('week')">Неделя</button>
        <button class="segment ${period === 'month' ? 'active' : ''}" onclick="setHistoryPeriod('month')">Месяц</button>
        <button class="segment ${period === 'all' ? 'active' : ''}" onclick="setHistoryPeriod('all')">Всё время</button>
      </div>

      <section class="panel hero-stats">
        <div class="hs-top">
          <div class="hs-big">
            <span class="hs-num">${total}</span>
            <span class="hs-cap">${plural(total, 'чаепитие', 'чаепития', 'чаепитий')}</span>
          </div>
          <div class="hs-streak ${streak ? '' : 'off'}">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3c1 3.5 5 5.5 5 10a5 5 0 0 1-10 0c0-2 1-3 2-4 .3 1.3 1 2 2 2 0-3-1-5 1-8z"/></svg>
            <b>${streak}</b> ${plural(streak, 'день', 'дня', 'дней')} подряд
          </div>
        </div>
        <div class="hist-chart ${dense ? 'dense' : ''}">${chartHtml}</div>
        <div class="hs-row">
          <div><b>${total ? formatDuration(totalMin) : '—'}</b><span>за чаем</span></div>
          <div><b>${totalPours}</b><span>${plural(totalPours, 'пролив', 'пролива', 'проливов')}</span></div>
          <div><b>${rated.length ? avgRating.toFixed(1) : '—'}</b><span>средняя оценка</span></div>
        </div>
      </section>

      ${catList.length ? `
      <section class="panel mt-16">
        <span class="overline">Что пьём</span>
        <div class="catbar">${catList.map(c => `<i style="flex:${c.n};--c:${c.color}" title="${escapeHtml(c.name)} — ${c.n}"></i>`).join('')}</div>
        <div class="catlegend">
          ${catList.slice(0, 5).map(c => `<span><i style="--c:${c.color}"></i>${escapeHtml(c.name)} <em>${Math.round(c.n / total * 100)}%</em></span>`).join('')}
        </div>
        ${topTeas.length ? `
        <div class="topteas">
          ${topTeas.map((t, i) => `
            <div class="toptea" onclick="navigate('tea-detail',{teaId:'${t.id}'})">
              <span class="toptea-n">${i + 1}</span>
              <span class="toptea-name">${escapeHtml(t.name)}</span>
              <span class="toptea-bar"><i style="width:${Math.round(t.n / topMax * 100)}%;--c:${t.color}"></i></span>
              <span class="toptea-c">${t.n}</span>
            </div>`).join('')}
        </div>` : ''}
      </section>` : ''}

      ${tasteStatsHtml(sessions)}

      <div class="hist-groups">
        ${Object.entries(groups).map(([key, list]) => `
          <section>
            <div class="day-head"><span>${dayLabel(key)}</span><em>${list.length} ${plural(list.length, 'чай', 'чая', 'чаёв')}</em></div>
            <div class="panel flush">${list.map(sessionRow).join('')}</div>
          </section>`).join('')}
      </div>

      ${total === 0 ? `
        <div class="empty-state">
          <svg width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 26h40v6a18 18 0 0 1-18 18h-4A18 18 0 0 1 10 32z"/><path d="M50 29h3a5 5 0 0 1 0 10h-5"/><path d="M22 10c-3 3 3 5 0 9M32 8c-3 3 3 5 0 9M42 10c-3 3 3 5 0 9"/></svg>
          <p class="font-display">${all.length ? 'За этот период пусто' : 'Пока пусто'}</p>
          <span>${all.length ? 'Выберите другой период или заварите чай' : 'Заварите первый чай — и история появится здесь'}</span>
        </div>` : ''}
    </div>
  `;
}

// ============================================
// Bottom sheet: детали чаепития
// ============================================
function closeSessionSheet() {
  const el = document.getElementById('session-sheet');
  if (!el) return;
  const note = el.querySelector('#sheet-note');
  if (note) note.blur();                    // сохранить заметку до закрытия
  el.classList.remove('open');
  setTimeout(() => el.remove(), 260);
}

async function saveSessionPatch(id, patch) {
  const s = state.sessions.find(x => x.id === id);
  if (!s) return;
  Object.assign(s, patch);
  await db.saveSession(s);
}

async function rateSession(id, n) {
  const next = await RatingService.setSessionRating(id, n);
  const host = document.getElementById('sheet-stars');
  if (host) host.querySelectorAll('button').forEach((el, i) => el.classList.toggle('on', i < next));
  const hint = document.querySelector('#session-sheet .sheet-hint');
  if (hint && next) hint.textContent = ['', 'Не зашло', 'Так себе', 'Нормально', 'Хороший чай', 'Отличный чай!'][next];
  if (navigator.vibrate && state.settings.vibration_enabled) navigator.vibrate(8);
  refreshVisibleScreen();
}

// Перерисовать открытый экран, чтобы данные сразу были актуальны
function refreshVisibleScreen() {
  const sc = state.currentScreen;
  if (sc === 'history') renderHistory();
  else if (sc === 'home') renderHome();
  else if (sc === 'catalog') updateCatalogList();
}

async function saveSessionNote(id, text) {
  await saveSessionPatch(id, { notes: text.trim() });
  refreshVisibleScreen();
}

function repeatSession(id) {
  const s = state.sessions.find(x => x.id === id);
  if (!s) return;
  closeSessionSheet();
  setTimeout(() => navigate('session-setup', { teaId: s.tea_id }), 120);
}

let _deleteArm = null;
async function deleteSessionConfirm(id, btn) {
  if (_deleteArm !== id) {
    _deleteArm = id;
    btn.textContent = 'Нажмите ещё раз — удалить';
    btn.classList.add('armed');
    setTimeout(() => { if (_deleteArm === id) { _deleteArm = null; if (btn.isConnected) { btn.textContent = 'Удалить запись'; btn.classList.remove('armed'); } } }, 3000);
    return;
  }
  _deleteArm = null;
  await db.deleteSession(id);
  state.sessions = await db.getSessions();
  closeSessionSheet();
  refreshVisibleScreen();
}

function openSessionSheet(id, opts = {}) {
  const s = state.sessions.find(x => x.id === id);
  if (!s) return;
  closeSessionSheet();

  const t = getTea(s.tea_id);
  const c = t ? getCategory(t.category) : null;
  const accent = c ? c.accent : '#B9AB88';
  const log = s.infusion_log || [];

  // Факт и передержка по каждому проливу. Новые записи хранят actual/overtime,
  // для старых считаем по разнице между сливами.
  let prev = new Date(s.start_time).getTime();
  const rows = log.map((inf, i) => {
    let actual = null, over = 0;
    if (inf.poured_at) {
      const at = new Date(inf.poured_at).getTime();
      if (typeof inf.actual_seconds === 'number') {
        actual = inf.actual_seconds;
        over = inf.overtime_seconds || 0;
      } else {
        actual = Math.max(1, Math.round((at - prev) / 1000));
        over = Math.max(0, actual - inf.planned_seconds);
      }
      prev = at;
    }
    return { i: i + 1, planned: inf.planned_seconds, actual, over, skipped: !!inf.skipped, tags: inf.tags || [] };
  });
  const maxSec = Math.max(1, ...rows.map(r => Math.max(r.planned, r.actual || 0)));
  const totalActual = rows.reduce((a, r) => a + (r.actual || 0), 0);
  const totalOver = rows.reduce((a, r) => a + r.over, 0);
  const totalPlanned = rows.filter(r => r.actual).reduce((a, r) => a + r.planned, 0);
  const strengthName = { light: 'лёгкая', medium: 'средняя', strong: 'крепкая' }[s.strength] || '—';

  const sheet = document.createElement('div');
  sheet.id = 'session-sheet';
  sheet.className = 'sheet';
  sheet.style.setProperty('--c', accent);
  sheet.innerHTML = `
    <div class="sheet-backdrop" onclick="closeSessionSheet()"></div>
    <div class="sheet-panel" role="dialog" aria-label="Чаепитие">
      <div class="sheet-grab"></div>
      <div class="sheet-head">
        <span class="gem lg" style="--c:${accent}"></span>
        <div>
          <h2>${escapeHtml(s.tea_name_snapshot)}</h2>
          <span>${dayLabel(dayKey(s.start_time))}, ${hhmm(s.start_time)}${s.end_time ? ' → ' + hhmm(s.end_time) : ''}</span>
        </div>
      </div>

      ${opts.justFinished ? '<p class="sheet-hint">Чаепитие завершено. Как вам этот чай?</p>' : ''}

      <div class="sheet-stars" id="sheet-stars">
        ${[1, 2, 3, 4, 5].map(n => `<button class="${(s.rating || 0) >= n ? 'on' : ''}" onclick="rateSession('${s.id}', ${n})" aria-label="${n}">★</button>`).join('')}
      </div>

      <div class="sheet-stats">
        <div><b>${sessionPours(s)}<small>/${log.length}</small></b><span>проливов</span></div>
        <div><b>${formatTime(totalActual)}</b><span>в чайнике</span></div>
        <div class="${totalOver ? 'warn' : ''}"><b>${totalOver ? '+' + formatTime(totalOver) : '0:00'}</b><span>передержка</span></div>
      </div>

      <div class="sheet-gm">
        <label>Заварка <input type="number" inputmode="decimal" step="0.5" min="0" value="${s.grams || ''}" placeholder="—" onchange="saveSessionGm('${s.id}', 'grams', this.value)"><em>г</em></label>
        <label>Посуда <input type="number" inputmode="numeric" step="10" min="0" value="${s.vessel_ml || ''}" placeholder="—" onchange="saveSessionGm('${s.id}', 'vessel', this.value)"><em>мл</em></label>
        <span id="sg-ratio">${gmRatioText(s.grams, s.vessel_ml, t)}</span>
      </div>

      <span class="overline">Проливы: время с передержкой</span>
      <div class="sheet-bars">
        ${rows.map(r => {
          const planW = Math.round(Math.min(r.planned, r.actual || r.planned) / maxSec * 100);
          const overW = Math.round(r.over / maxSec * 100);
          return `
          <div class="sb ${r.skipped ? 'skip' : ''}">
            <span class="sb-n">${r.i}</span>
            <span class="sb-track">
              ${r.actual ? `<i class="fact" style="width:${planW}%"></i>${overW ? `<i class="over" style="left:${planW}%;width:${overW}%"></i>` : ''}` : `<i class="plan" style="width:${Math.round(r.planned / maxSec * 100)}%"></i>`}
              <i class="mark" style="left:${Math.round(r.planned / maxSec * 100)}%"></i>
            </span>
            <span class="sb-v">${r.skipped ? 'пропущен' : r.actual
              ? `<b>${formatTime(r.actual)}</b><small>план ${formatTime(r.planned)}</small>${r.over ? `<em>+${formatTime(r.over)}</em>` : ''}`
              : `— <small>план ${formatTime(r.planned)}</small>`}</span>
          </div>`;
        }).join('')}
      </div>

      ${rows.some(r => r.tags.length) ? `
      <span class="overline">Вкус по проливам</span>
      <div class="sheet-tastes">
        ${rows.filter(r => r.tags.length).map(r => `<div><b>${r.i}</b>${r.tags.map(t => `<span>${escapeHtml(t)}</span>`).join('')}</div>`).join('')}
      </div>` : ''}
      <div class="sheet-total">
        <span>Всего: <b>${formatTime(totalActual)}</b> <small>при плане ${formatTime(totalPlanned)}</small></span>
        <span class="${totalOver ? 'warn' : ''}">${totalOver ? 'передержка +' + formatTime(totalOver) : 'без передержки'}</span>
      </div>

      ${s.effects_snapshot && Object.keys(s.effects_snapshot).length ? `
        <div class="sheet-tags">${Object.keys(s.effects_snapshot).map(k => `<span class="tag">${escapeHtml(s.effects_snapshot[k] || k)}</span>`).join('')}</div>` : ''}

      <label class="overline" for="sheet-note">Заметка</label>
      <textarea id="sheet-note" class="sheet-note" rows="2" placeholder="Вкус, аромат, послевкусие…" onblur="saveSessionNote('${s.id}', this.value)">${escapeHtml(s.notes || '')}</textarea>

      <div class="sheet-actions">
        <button class="btn-primary sm" onclick="repeatSession('${s.id}')">Заварить снова</button>
        <button class="btn-secondary" onclick="closeSessionSheet()">Закрыть</button>
      </div>
      <button class="sheet-delete" onclick="deleteSessionConfirm('${s.id}', this)">Удалить запись</button>
    </div>
  `;
  document.getElementById('app').appendChild(sheet);
  requestAnimationFrame(() => sheet.classList.add('open'));
}

