  container.innerHTML = `
    <div class="screen-content cs">
      <div class="cs-head">
        <button class="btn-icon sm" onclick="goBack()" aria-label="Назад">←</button>
        <div>
          <span class="overline" style="margin-bottom:0;">Свой сценарий</span>
          <h1>Своя лестница</h1>
        </div>
      </div>

      ${tea ? `<div class="cs-tea"><span class="gem" style="--c:${cat.accent}"></span><b>${escapeHtml(tea.name_ru)}</b><span>${tea.temperature_min}–${tea.temperature_max}°C</span></div>` : ''}

      ${sc ? gmBlockHtml(tea) : ''}

