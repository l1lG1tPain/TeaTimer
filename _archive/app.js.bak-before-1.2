function csSummaryHtml() {
  const t = state.customScenarioTimes;
  const total = t.reduce((a, b) => a + b, 0);
  return `<div><b>${t.length}</b><span>${plural(t.length, 'пролив', 'пролива', 'проливов')}</span></div>
          <div><b>${formatTime(total)}</b><span>вся заварка</span></div>
          <div><b>${formatTime(t[0] || 0)}→${formatTime(t[t.length - 1] || 0)}</b><span>первый → последний</span></div>`;
}

// Обновляем только полосы и итоги — поле не теряет фокус
function csRefreshInPlace() {
  const t = state.customScenarioTimes;
  const maxSec = Math.max(...t, 90);
  document.querySelectorAll('#cs-rows .cs-row').forEach((row, i) => {
    const bar = row.querySelector('.bar-fill'); if (bar) bar.style.width = Math.round((t[i] / maxSec) * 100) + '%';
    const inp = row.querySelector('input.sec'); if (inp && document.activeElement !== inp) inp.value = t[i];
  });
  const sum = document.getElementById('cs-summary'); if (sum) sum.innerHTML = csSummaryHtml();
}

function shiftAll(delta) {
  state.customScenarioTimes = state.customScenarioTimes.map(t => Math.max(5, t + delta));
  csRefreshInPlace();
}

function stepCustomTime(idx, delta) {
  state.customScenarioTimes[idx] = Math.max(5, Math.min(999, state.customScenarioTimes[idx] + delta));
  if (navigator.vibrate) navigator.vibrate(5);
  csRefreshInPlace();
}

function updateCustomTime(idx, val) {
  const v = parseInt(val) || 5;
  state.customScenarioTimes[idx] = Math.max(5, Math.min(999, v));
  csRefreshInPlace();
  const inp = document.querySelector(`#cs-rows .cs-row[data-i="${idx}"] input.sec`);
  if (inp) inp.value = state.customScenarioTimes[idx];
}

function addCustomInfusion() {
  const t = state.customScenarioTimes;
  if (t.length >= 20) return;
  const step = t.length > 1 ? Math.max(0, t[t.length - 1] - t[t.length - 2]) : 5;
  t.push(Math.min(999, (t[t.length - 1] || 30) + (step || 5)));
  renderCustomScenario();
}

let _lastRemoved = null;
function removeCustomInfusion(idx) {
  const t = state.customScenarioTimes;
  if (t.length <= 1) return;
  _lastRemoved = { idx, val: t[idx] };
  t.splice(idx, 1);
  renderCustomScenario();
  showToast(`Пролив ${idx + 1} удалён`, 'Вернуть', () => {
    if (!_lastRemoved) return;
    state.customScenarioTimes.splice(_lastRemoved.idx, 0, _lastRemoved.val);
    _lastRemoved = null;
    renderCustomScenario();
  });
}

function resetCustomScenario() {
  const sc = state.currentScenario;
  if (!sc) return;
  state.customScenarioTimes = generateScenario(sc.tea, sc.strength === 'custom' ? 'medium' : sc.strength, sc.numInfusions || sc.tea.max_infusions);
  renderCustomScenario();
}

// Небольшое всплывающее сообщение (с необязательным действием)
let _toastTimer = null;
function showToast(msg, actionLabel, action) {
  const old = document.getElementById('app-toast'); if (old) old.remove();
  clearTimeout(_toastTimer);
  const el = document.createElement('div');
  el.id = 'app-toast'; el.className = 'app-toast';
  el.innerHTML = `<span>${escapeHtml(msg)}</span>${actionLabel ? `<button>${escapeHtml(actionLabel)}</button>` : ''}`;
  if (actionLabel) el.querySelector('button').onclick = () => { el.remove(); action && action(); };
  document.getElementById('app').appendChild(el);
  _toastTimer = setTimeout(() => el.remove(), 4200);
}

async function loadPreset(id) {
  const p = (state.presets || []).find(x => x.id === id);
  if (!p) return;
  state.customScenarioTimes = [...p.times];
  state.customScenarioName = p.name;
  renderCustomScenario();
  showToast(`Загружен: ${p.name}`);
}

async function deletePreset(id) {
  await db.deletePreset(id);
  state.presets = await db.getPresets();
  renderCustomScenario();
}

async function savePreset() {
  const name = (state.customScenarioName || '').trim();
  if (!name) { showToast('Введите название сценария'); const i = document.querySelector('.cs-save input'); if (i) i.focus(); return; }
  const existing = (state.presets || []).find(p => p.name.toLowerCase() === name.toLowerCase());
  await db.savePreset({
    id: existing ? existing.id : generateId(),
    name,
    times: [...state.customScenarioTimes],
    created_at: new Date().toISOString()
  });
  state.presets = await db.getPresets();
  renderCustomScenario();
  showToast(existing ? 'Сценарий обновлён' : 'Сценарий сохранён');
}

function startCustomSession() {
  if (!state.currentTea) return;
  const sc = state.currentScenario;
  state.currentSession = {
    id: generateId(),
    tea_id: sc.tea.id,
    tea_name_snapshot: sc.tea.name_ru,
    strength: 'custom',
    grams: sc.grams, vessel_ml: sc.vesselMl,
    start_time: new Date().toISOString(),
    end_time: null,
    infusion_log: state.customScenarioTimes.map((planned, idx) => ({
      index: idx,
      planned_seconds: planned,
      poured_at: null
    })),
    rating: null,
    notes: '',
    effects_snapshot: sc.tea.effects && Object.keys(sc.tea.effects).length > 0 ? { ...sc.tea.effects } : {}
  };
  state.timerTargetEnd = null;
  navigate('timer');
}

