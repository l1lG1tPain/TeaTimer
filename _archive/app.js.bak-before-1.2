    ? [...state.sessions].sort((a, b) => new Date(b.start_time) - new Date(a.start_time))
    : [];

  const lastSession = sortedSessions.length > 0 ? sortedSessions[0] : null;
  const lastTea = lastSession ? getTea(lastSession.tea_id) : null;
