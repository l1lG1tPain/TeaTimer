// ============================================
// Оценки: локальный сервис с задатком под сервер
// ============================================
// Данные оценки (и чая, и чаепития) уже содержат всё, что понадобится
// для синхронизации: device_id (анонимный), updated_at и sync-статус.
// Когда появится сервер — достаточно реализовать push()/pull() ниже,
// остальное приложение менять не придётся.
const RatingService = {
  backend: 'local',

  deviceId() {
    try {
      let id = localStorage.getItem('teatimer_device_id');
      if (!id) { id = 'dev_' + generateId() + generateId(); localStorage.setItem('teatimer_device_id', id); }
      return id;
    } catch (e) { return 'dev_anonymous'; }
  },

  // Моя оценка чая (1..5) или 0
  teaRating(teaId) {
    const r = state.teaRatings && state.teaRatings[teaId];
    return r ? r.rating : 0;
  },

  async setTeaRating(teaId, n) {
    const now = new Date().toISOString();
    if (!n) {
      delete state.teaRatings[teaId];
      await db.setSetting('tea_rating:' + teaId, null);
      return;
    }
    const rec = { tea_id: teaId, rating: n, device_id: this.deviceId(), updated_at: now, sync: 'pending' };
    state.teaRatings[teaId] = rec;
    await db.setSetting('tea_rating:' + teaId, rec);
  },

  // Средняя по чаепитиям: { avg, count }
  sessionStats(teaId) {
    const rated = (state.sessions || []).filter(s => s.tea_id === teaId && s.rating);
    if (!rated.length) return { avg: 0, count: 0 };
    return { avg: rated.reduce((a, s) => a + s.rating, 0) / rated.length, count: rated.length };
  },

  // Для списков: сначала явная оценка чая, иначе среднее по чаепитиям
  displayRating(teaId) {
    const mine = this.teaRating(teaId);
    if (mine) return { value: mine, kind: 'mine' };
    const st = this.sessionStats(teaId);
    return st.count ? { value: st.avg, kind: 'avg' } : null;
  },

  async setSessionRating(sessionId, n) {
    const s = state.sessions.find(x => x.id === sessionId);
    if (!s) return 0;
    const next = s.rating === n ? 0 : n;      // тап по той же звезде снимает оценку
    s.rating = next || null;
    s.rated_at = next ? new Date().toISOString() : null;
    s.device_id = this.deviceId();
    s.sync = 'pending';
    await db.saveSession(s);
    return next;
  },

  // --- задел под сервер ---
  async push() { return { pushed: 0, backend: this.backend }; },
  async globalStats(/* teaId */) { return null; }   // { avg, count } от сообщества, когда появится сервер
};

function ratingBadge(teaId) {
  const r = RatingService.displayRating(teaId);
  if (!r) return '';
  return `<span class="rbadge ${r.kind}">★ ${r.value.toFixed(1)}</span>`;
}

// ---- helpers ----
function dayKey(d) {
  d = new Date(d);
  return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
}
function hhmm(d) {
  d = new Date(d);
  return String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
}
function sessionMinutes(s) {
  const start = new Date(s.start_time);
  const end = s.end_time ? new Date(s.end_time) : start;
  return Math.max(0, Math.round((end - start) / 60000));
}
function sessionPours(s) {
  return (s.infusion_log || []).filter(i => i.poured_at).length;
}
function starsHtml(n, cls = '') {
  n = n || 0;
  let out = '';
  for (let i = 1; i <= 5; i++) out += `<i class="${i <= n ? 'on' : ''}">★</i>`;
  return `<span class="stars ${cls}" aria-label="Оценка ${n} из 5">${out}</span>`;
}
function dayLabel(key) {
  const today = dayKey(new Date());
  const y = new Date(); y.setDate(y.getDate() - 1);
  if (key === today) return 'Сегодня';
  if (key === dayKey(y)) return 'Вчера';
  const [Y, M, D] = key.split('-').map(Number);
  return new Date(Y, M - 1, D).toLocaleDateString('ru-RU', { weekday: 'short', day: 'numeric', month: 'long' });
}
function plural(n, one, few, many) {
  const m10 = n % 10, m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return one;
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return few;
  return many;
}

// Серия: сколько дней подряд (до сегодня/вчера) был хотя бы один чай
function calcStreak(sessions) {
  const days = new Set(sessions.map(s => dayKey(s.start_time)));
  const d = new Date();
  if (!days.has(dayKey(d))) d.setDate(d.getDate() - 1);
  let n = 0;
  while (days.has(dayKey(d))) { n++; d.setDate(d.getDate() - 1); }
  return n;
}

// Столбики для графика: неделя — 7 дней, месяц — 30 дней, всё время — 12 месяцев
function buildBuckets(sessions, period) {
  const buckets = [];
  const now = new Date();
  if (period === 'all') {
    for (let i = 11; i >= 0; i--) {
      const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
      buckets.push({ key: d.getFullYear() + '-' + d.getMonth(), label: d.toLocaleDateString('ru-RU', { month: 'short' }).replace('.', ''), n: 0, cur: i === 0 });
    }
    sessions.forEach(s => {
      const d = new Date(s.start_time);
      const b = buckets.find(x => x.key === d.getFullYear() + '-' + d.getMonth());
      if (b) b.n++;
    });
  } else {
    const days = period === 'week' ? 7 : 30;
    for (let i = days - 1; i >= 0; i--) {
      const d = new Date(now); d.setDate(d.getDate() - i);
      buckets.push({
        key: dayKey(d),
        label: period === 'week' ? d.toLocaleDateString('ru-RU', { weekday: 'short' }) : String(d.getDate()),
        n: 0, cur: i === 0
      });
    }
    sessions.forEach(s => {
      const b = buckets.find(x => x.key === dayKey(s.start_time));
      if (b) b.n++;
    });
  }
  return buckets;
}

function setHistoryPeriod(p) {
  state.historyPeriod = p;
  renderHistory();
}

