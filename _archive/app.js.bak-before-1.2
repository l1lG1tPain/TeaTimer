  const handTeas = handIds.map(id => getTea(id)).filter(Boolean);
  for (let i = 0; handTeas.length < 4 && i < TEAS.length; i++) {
    const t = TEAS[i];
    if (t && !handTeas.includes(t)) handTeas.push(t);
  }

  // Weekly stats
  const weekAgo = new Date(); weekAgo.setDate(weekAgo.getDate() - 7);
