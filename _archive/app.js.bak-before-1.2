const MOODS = [
  { id: 'energy',  label: 'Бодрость',     cats: { green: 10, white: 7, oolong_light: 9, red: 6, yellow: 6 }, tags: ['свежий', 'цветочный'], why: 'бодрит' },
  { id: 'calm',    label: 'Спокойствие',  cats: { white: 10, yellow: 8, oolong_light: 7, puerh_shou: 8, heicha: 7 }, tags: ['мягкий', 'сладкий', 'нежный'], why: 'для спокойствия' },
  { id: 'warm',    label: 'Согреться',    cats: { red: 10, oolong_dark: 9, puerh_shou: 9, heicha: 8 }, tags: ['пряный', 'плотный', 'сладкий'], why: 'согревает' },
  { id: 'fresh',   label: 'Освежиться',   cats: { green: 10, white: 8, yellow: 7, oolong_light: 8, puerh_sheng: 5 }, tags: ['свежий', 'лёгкий', 'цветочный'], why: 'освежает' },
  { id: 'evening', label: 'На вечер',     cats: { puerh_shou: 10, heicha: 10, white: 6 }, tags: ['мягкий', 'сладкий', 'землистый', 'выдержанный'], why: 'для вечера', allow: t => t.category !== 'white' || /выдержан|шоу мэй|гун мэй|лао бай/i.test((t.tags || []).join(' ') + ' ' + t.name_ru) }
];
function defaultMood() {
  const h = new Date().getHours();
  return h < 11 ? 'energy' : h < 16 ? 'fresh' : h < 20 ? 'warm' : 'evening';
}
function daySeed() {
  const d = new Date(); return d.getFullYear() * 400 + d.getMonth() * 31 + d.getDate();
}
function hashStr(str) { let h = 0; for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0; return Math.abs(h); }

function suggestTeas(moodId, n = 3) {
  const mood = MOODS.find(m => m.id === moodId) || MOODS[0];
  const now = Date.now();
  const last = {};
  (state.sessions || []).forEach(s => { const t = new Date(s.start_time).getTime(); if (!last[s.tea_id] || t > last[s.tea_id]) last[s.tea_id] = t; });
  const favs = new Set(state.favorites || []);
  const scored = TEAS.map(t => {
    let sc = (mood.cats[t.category] || 0) * 10;
    if (!sc || (mood.allow && !mood.allow(t))) return null;
    const tg = (t.tags || []).map(x => x.toLowerCase());
    mood.tags.forEach(x => { if (tg.some(y => y.includes(x))) sc += 6; });
    if (favs.has(t.id)) sc += 8;
    const r = RatingService.displayRating(t.id); if (r) sc += (r.value - 3) * 4;
    const l = last[t.id];
    let reason = mood.why;
    if (!l) { sc += 5; reason = mood.why + ' · ещё не пробовали'; }
    else {
      const days = (now - l) / 864e5;
      if (days < 2) sc -= 25; else if (days > 10) { sc += 6; reason = mood.why + ' · давно не пили'; }
    }
    if (favs.has(t.id) && l) reason = mood.why + ' · из избранного';
    sc += (hashStr(t.id + daySeed() + mood.id) % 17);   // ежедневная «встряска»
    return { t, sc, reason };
  }).filter(Boolean).sort((a, b) => b.sc - a.sc);
  // разнообразие: не больше двух чаёв одного вида
  const out = [], per = {};
  for (const x of scored) {
    if ((per[x.t.category] || 0) >= 2) continue;
    per[x.t.category] = (per[x.t.category] || 0) + 1;
    out.push(x); if (out.length >= n) break;
  }
  return out;
}
function todayCardHtml() {
  const mood = state.todayMood || defaultMood();
  const picks = suggestTeas(mood);
  return `
    <div class="today-chips">
      ${MOODS.map(m => `<button class="chip ${m.id === mood ? 'chip-active' : 'chip-inactive'}" onclick="setTodayMood('${m.id}')">${m.label}</button>`).join('')}
    </div>
    <div class="today-list">
      ${picks.map(p => {
        const cat = getCategory(p.t.category);
        return `<div class="tea-card-mini" onclick="navigate('tea-detail', {teaId:'${p.t.id}'})">
          <span class="gem" style="--c:${cat.accent}"></span>
          <div class="info"><span class="name">${escapeHtml(p.t.name_ru)}</span>
          <span class="meta">${escapeHtml(p.reason)} · ${cat.name_ru} · ${p.t.temperature_min}–${p.t.temperature_max}°C</span></div>
          <span class="count">${p.t.max_infusions} пр.</span></div>`;
      }).join('')}
    </div>`;
}
