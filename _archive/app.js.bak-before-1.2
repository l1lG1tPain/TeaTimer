                <span class="meta">${tea.name_cn ? escapeHtml(tea.name_cn) + ' · ' : ''}${cat.name_ru} · ${tea.temperature_min}–${tea.temperature_max}°C</span>
              </div>
              <span class="count">${infusions} пр.</span>
            </div>
            `;
          }).join('')}
        </div>
      </div>

