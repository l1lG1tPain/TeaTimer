// ============================================
// Граммы заварки и посуда: редактируются при заварке и в отчёте
// ============================================
function gmFmt(n) { return String(Math.round(n * 10) / 10).replace('.', ','); }
function gmRatioText(grams, ml, tea) {
  if (!grams || !ml) return 'укажите граммы и объём';
  const r = grams / ml * 100;
  const rec = tea ? tea.gaiwan_ratio_g_per_100ml : null;
  return `${gmFmt(r)} г на 100 мл` + (rec ? ` · рекомендуем ${gmFmt(rec)}` : '');
}
function gmFieldHtml(kind, label, value, unit, step) {
  return `
    <div class="gm-field">
      <span class="overline" style="margin-bottom:0;">${label}</span>
      <span class="gm-in">
        <button type="button" onclick="gmStep('${kind}', -${step})" aria-label="Меньше">−</button>
        <input class="gm-${kind}" type="number" inputmode="decimal" step="${step}" min="0" value="${value}" onchange="gmSet('${kind}', this.value)">
        <em>${unit}</em>
        <button type="button" onclick="gmStep('${kind}', ${step})" aria-label="Больше">+</button>
      </span>
    </div>`;
}
function gmBlockHtml(tea) {
  const sc = state.currentScenario;
  return `
    <div class="gm-block mt-20">
      <div class="gm-grid">
        ${gmFieldHtml('grams', 'Заварка', sc.grams, 'г', 0.5)}
        ${gmFieldHtml('vessel', 'Посуда', sc.vesselMl, 'мл', 10)}
      </div>
      <div class="gm-foot"><span id="gm-ratio">${gmRatioText(sc.grams, sc.vesselMl, tea)}</span>
        ${tea && tea.rinse_recommended ? '<b>нужна промывка</b>' : ''}</div>
    </div>`;
}
function gmSet(kind, raw) {
  const sc = state.currentScenario; if (!sc) return;
  let v = parseFloat(String(raw).replace(',', '.'));
  if (!isFinite(v) || v <= 0) v = kind === 'grams' ? sc.grams : sc.vesselMl;
  if (kind === 'grams') { sc.grams = Math.min(100, Math.round(v * 10) / 10); sc.gramsManual = true; }
  else {
    sc.vesselMl = Math.min(1000, Math.max(20, Math.round(v)));
    state.settings.default_vessel_ml = sc.vesselMl; db.setSetting('default_vessel_ml', sc.vesselMl);
    if (!sc.gramsManual) sc.grams = calcGrams(sc.tea, sc.vesselMl);   // пока граммы не вводили руками — считаем по рекомендации
  }
  document.querySelectorAll('input.gm-grams').forEach(el => { if (document.activeElement !== el) el.value = sc.grams; });
  document.querySelectorAll('input.gm-vessel').forEach(el => { if (document.activeElement !== el) el.value = sc.vesselMl; });
  document.querySelectorAll('#gm-ratio').forEach(el => { el.textContent = gmRatioText(sc.grams, sc.vesselMl, sc.tea); });
}
function gmStep(kind, delta) {
  const sc = state.currentScenario; if (!sc) return;
  gmSet(kind, (kind === 'grams' ? sc.grams : sc.vesselMl) + delta);
  if (navigator.vibrate) navigator.vibrate(5);
}

// Отчёт: поправить граммы и посуду уже после чаепития
async function saveSessionGm(id, kind, raw) {
  const s = state.sessions.find(x => x.id === id); if (!s) return;
  let v = parseFloat(String(raw).replace(',', '.'));
  const patch = {};
  if (!isFinite(v) || v <= 0) patch[kind === 'grams' ? 'grams' : 'vessel_ml'] = null;
  else if (kind === 'grams') patch.grams = Math.min(100, Math.round(v * 10) / 10);
  else patch.vessel_ml = Math.min(1000, Math.max(20, Math.round(v)));
  await saveSessionPatch(id, patch);
  const el = document.getElementById('sg-ratio');
  if (el) el.textContent = gmRatioText(s.grams, s.vessel_ml, getTea(s.tea_id));
  refreshVisibleScreen();
}

function setStrength(s) {
  if (!state.currentScenario) return;
  state.currentScenario.strength = s;
  state.settings.default_strength = s;
  db.setSetting('default_strength', s);
  updateScenarioPreview();
  const segs = document.querySelectorAll('.segmented .segment');
  segs.forEach((btn, i) => {
    const val = ['light', 'medium', 'strong'][i];
    btn.classList.toggle('active', val === s);
  });
}

function infusionPct(val, max) {
  return max <= 1 ? 100 : ((val - 1) / (max - 1)) * 100;
}

function setInfusionFromX(clientX) {
  const sc = state.currentScenario;
  const track = document.getElementById('infusion-track');
  if (!sc || !track) return;
  const max = sc.tea.max_infusions;
  const rect = track.getBoundingClientRect();
  const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
  const val = max <= 1 ? 1 : Math.round(1 + pct * (max - 1));
  if (val === sc.numInfusions) return;
  sc.numInfusions = val;
  if (navigator.vibrate) navigator.vibrate(6);
  updateScenarioPreview();
  updateInfusionSlider();
}

// Ползунок тянется пальцем (и мышью); тап по дорожке тоже работает
function startInfusionDrag(e) {
  if (!state.currentScenario) return;
  const hit = e.currentTarget;
  e.preventDefault();
  try { hit.setPointerCapture(e.pointerId); } catch (_) {}
  hit.classList.add('dragging');
  setInfusionFromX(e.clientX);
  const move = ev => setInfusionFromX(ev.clientX);
  const end = () => {
    hit.classList.remove('dragging');
    hit.removeEventListener('pointermove', move);
    hit.removeEventListener('pointerup', end);
    hit.removeEventListener('pointercancel', end);
  };
  hit.addEventListener('pointermove', move);
  hit.addEventListener('pointerup', end);
  hit.addEventListener('pointercancel', end);
}

function updateInfusionSlider() {
  const val = state.currentScenario.numInfusions;
  const max = state.currentScenario.tea.max_infusions;
  const pct = infusionPct(val, max);
  const fill = document.getElementById('setup-infusion-fill');
  const thumb = document.getElementById('setup-infusion-thumb');
  const count = document.getElementById('setup-infusion-count');
  if (fill) fill.style.width = pct + '%';
  if (thumb) thumb.style.left = `calc(${pct}% - 15px)`;
  if (count) count.textContent = val;
}

function updateScenarioPreview() {
  const sc = state.currentScenario;
  if (!sc) return;
  const times = generateScenario(sc.tea, sc.strength, sc.numInfusions);
  sc.times = times;
  const chips = document.getElementById('setup-scenario-chips');
  if (chips) {
    chips.innerHTML = times.map(sec => `<span class="scenario-chip">${sec}</span>`).join('');
  }
}

function startSession() {
  if (!state.currentScenario) return;
  const sc = state.currentScenario;
  state.currentSession = {
    id: generateId(),
    tea_id: sc.tea.id,
    tea_name_snapshot: sc.tea.name_ru,
    strength: sc.strength,
    grams: sc.grams, vessel_ml: sc.vesselMl,
    start_time: new Date().toISOString(),
    end_time: null,
    infusion_log: sc.times.map((planned, idx) => ({
      index: idx,
      planned_seconds: planned,
      poured_at: null
    })),
    rating: null,
    notes: '',
    effects_snapshot: sc.tea.effects && Object.keys(sc.tea.effects).length > 0 ? { ...sc.tea.effects } : {}
  };
  state.customScenarioTimes = [...sc.times];
  state.customScenarioName = '';
  state.timerTargetEnd = null; // reset timer target
  navigate('timer');
}

// ============================================
// Screen: Custom Scenario
// ============================================
function openCustomScenario() {
