              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg>
            </button>
          </div>`).join('')}
        <button class="btn-secondary btn-dashed" style="height:52px;border-radius:16px;" onclick="addCustomInfusion()" ${times.length >= 20 ? 'disabled' : ''}>
          + Ещё пролив
        </button>
      </div>

      <div class="cs-save">
