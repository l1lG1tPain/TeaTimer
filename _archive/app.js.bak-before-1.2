// ============================================
// Подсказки «на что смотреть» и теги вкуса
// ============================================
const TASTE_TAGS = ['сладкий', 'цветочный', 'фруктовый', 'медовый', 'древесный', 'минеральный', 'дымный', 'густой', 'свежий', 'терпкий', 'горчит', 'пресный'];
const BREW_TIPS = {
  white:        ['Вдохните аромат сухого листа и крышки: сено, мёд, цветы.', 'Настой светлеет и сладеет — ловите медовые ноты и мягкую текстуру.', 'Вкус стал прозрачнее. Нужно ли добавить 5–10 секунд?'],
  green:        ['Аромат свежий и травяной. Листья должны раскрыться, но не вариться.', 'Сладость и бобовые ноты — признак хорошего пролива. Не передерживайте.', 'Вкус светлеет. Вода не выше 85 °C, чтобы не появилась горечь.'],
  yellow:       ['Мягкий хлебный аромат. Следите за нежной сладостью без горечи.', 'Обратите внимание на гладкость и послевкусие.', 'Настой становится легче — самое время для спокойной беседы.'],
  oolong_light: ['Вдохните цветочный аромат на крышке: орхидея, сирень, сливки.', 'Лист раскрывается — аромат и вкус на пике. Фиксируйте послевкусие.', 'Остаётся сладость и свежесть. Добавляйте секунды понемногу.'],
  oolong_dark:  ['Аромат обжарки: карамель, орех, сухофрукты. Дайте чаю раскрыться.', 'Минеральность и «скала» чувствуются больше. Следите за густотой.', 'Обжиг отступает, вкус мягче — виден сам лист.'],
  red:          ['Аромат мёда, сладкого картофеля, какао. Настой должен быть янтарным.', 'Вкус на пике: сладость, пряность, плотное тело.', 'Настой светлеет, остаётся мягкая сладость. Подходит для долгих проливов.'],
  puerh_sheng:  ['Первые проливы короткие: ловите цветочные и травяные ноты, горчинка быстро уходит.', 'Следите за «хуэй гань» — сладким возвращением после горечи.', 'Сила держится долго: вкус переходит к мёду и сухофруктам.'],
  puerh_shou:   ['Аромат земли, дерева, какао — без «прудового» запаха после промывки.', 'Настой густой и тёмный. Гладкая текстура — признак хорошего шу.', 'Вкус остаётся сладким и плотным: можно пить ещё много проливов.'],
  heicha:       ['Аромат дерева, финика, старой бумаги. Промывка уже сделала своё дело.', 'Густота и мягкость — главное. Ловите сладкие ноты.', 'Хэй ча терпелив: настой остаётся плотным ещё долго.']
};
function brewTip(tea, idx, total) {
  const arr = BREW_TIPS[tea ? tea.category : ''] || ['Вдохните аромат, посмотрите на цвет настоя и запомните вкус.'];
  const stage = idx === 0 ? 0 : (idx >= total - 1 && total > 2 ? 2 : (idx / Math.max(1, total - 1) > 0.6 ? 2 : 1));
  return arr[Math.min(stage, arr.length - 1)];
}
function toggleTasteTag(tag, btn) {
  const sess = state.currentSession; if (!sess) return;
  const inf = sess.infusion_log.find(i => i.poured_at === null && !i.skipped);
  if (!inf) return;
  inf.tags = inf.tags || [];
  const k = inf.tags.indexOf(tag);
  if (k >= 0) inf.tags.splice(k, 1); else inf.tags.push(tag);
  if (btn) btn.classList.toggle('on', k < 0);
  if (navigator.vibrate && state.settings.vibration_enabled) navigator.vibrate(8);
  db.saveSession(sess);
}

// Насыщенность настоя 0.35..1.25: кривая по проливам × крепость
function brewIntensity(idx, total, strength) {
  const x = total > 1 ? idx / (total - 1) : 0.3;
  const curve = x < 0.3 ? 0.8 + (x / 0.3) * 0.2 : 1 - ((x - 0.3) / 0.7) * 0.62;
  const mul = { light: 0.84, medium: 1, strong: 1.18, custom: 1 }[strength] || 1;
  return Math.max(0.35, Math.min(1.25, curve * mul));
}
function tintAccent(hex, I) {
  const [r, g, b] = hexToRgb(hex);
  const mix = (to, t) => '#' + [r, g, b].map((v, i) => Math.round(v + (to[i] - v) * t).toString(16).padStart(2, '0')).join('');
  if (I < 1) return mix([248, 238, 208], Math.min(0.8, (1 - I) * 0.85));
  return mix([46, 24, 8], Math.min(0.4, (I - 1) * 1.5));
}

// ---- Таймер: логика ----
const TIMER_TICKS = 40;
const WAVE_TILE = { front: 120, back: 170 };
const REDUCED_MOTION = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

function hexToRgb(hex) {
  const n = parseInt(hex.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function _lin(c) { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); }
function _lum([r, g, b]) { return 0.2126 * _lin(r) + 0.7152 * _lin(g) + 0.0722 * _lin(b); }
// Тёмный или светлый текст читается лучше на этом цвете настоя?
function contrastText(rgb) {
  const L = _lum(rgb);
  const dark = _lum([30, 27, 21]), light = _lum([253, 248, 235]);
  const cDark = (L + 0.05) / (dark + 0.05);
  const cLight = (light + 0.05) / (L + 0.05);
  return cDark >= cLight ? '#1E1B15' : '#FDF8EB';
}

// Прогресс 0..1 по реальному времени (не зависит от тиков интервала)
function timerProgress() {
  if (!state.timerTargetEnd || !state.timerTotal) return 0;
  const left = (state.timerTargetEnd - Date.now()) / 1000;
  return Math.min(1, Math.max(0, 1 - left / state.timerTotal));
}

function startTimer(seconds) {
  stopTimer();
  state.timerTotal = seconds;
  if (!state.timerTargetEnd) {           // новый пролив
    state.timerTargetEnd = Date.now() + seconds * 1000;
    state.timerNotified = false;
  }
  state.timerRunning = true;

  if (state.settings.keep_screen_on) requestWakeLock();
  armAlarm();
  startKeepAlive();

  updateTimerDisplay();
  // Интервал живёт и после конца — считает «перестой»
  state.timerInterval = setInterval(updateTimerDisplay, 1000);
  // Точный выстрел ровно в конец (интервал может «поплыть» в фоне)
  const ms = Math.max(0, state.timerTargetEnd - Date.now()) + 30;
  state.timerEndTimeout = setTimeout(updateTimerDisplay, ms);
  startTimerFrames();
}

function stopTimerLoops() {
  if (state.timerInterval) { clearInterval(state.timerInterval); state.timerInterval = null; }
  if (state.timerEndTimeout) { clearTimeout(state.timerEndTimeout); state.timerEndTimeout = null; }
  if (state.timerRaf) { cancelAnimationFrame(state.timerRaf); state.timerRaf = null; }
}

function stopTimer() {
  stopTimerLoops();
  disarmAlarm();
  stopKeepAlive();
  state.timerRunning = false;
  releaseWakeLock();
}

// Плавная анимация: уровень настоя, волны, тики, «энергия»
function startTimerFrames() {
  const root = document.getElementById('timer-overlay');
  const vessel = document.getElementById('vessel');
  const front = document.getElementById('liquid-front');
  const back = document.getElementById('liquid-back');
  const ticks = root ? root.querySelectorAll('#t-ticks line') : [];
  if (!root || !vessel || !front || !back) return;

  let last = performance.now();
  let pa = Math.random() * WAVE_TILE.front;
  let pb = Math.random() * WAVE_TILE.back;
  let lastOn = -1, lastEnergy = -1;

  const frame = (now) => {
    if (!document.getElementById('timer-overlay')) { state.timerRaf = null; return; }
    state.timerRaf = requestAnimationFrame(frame);

    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;

    const p = timerProgress();
    const level = 0.08 + 0.86 * p;                     // кружка никогда не «переполнена» до краёв
    vessel.style.setProperty('--p', level.toFixed(4));

    // Чем ближе конец — тем «кипучее»
    const energy = 0.35 + 0.65 * Math.pow(p, 1.4);
    if (Math.abs(energy - lastEnergy) > 0.01) {
      root.style.setProperty('--energy', energy.toFixed(3));
      lastEnergy = energy;
    }

    if (!REDUCED_MOTION) {
      const speed = 18 + energy * 62;                  // px/с
      pa = (pa + dt * speed) % WAVE_TILE.front;
      pb = (pb - dt * speed * 0.62 + WAVE_TILE.back) % WAVE_TILE.back;
      front.style.setProperty('--wx', (-pa).toFixed(1) + 'px');
      back.style.setProperty('--wx', (-pb).toFixed(1) + 'px');
    }

    const on = Math.floor(p * TIMER_TICKS);
    if (on !== lastOn) {
      ticks.forEach((t, i) => {
        t.classList.toggle('on', i < on);
        t.classList.toggle('head', i === on && p < 1);
      });
      lastOn = on;
    }
  };
  state.timerRaf = requestAnimationFrame(frame);
}

function updateTimerDisplay() {
  if (!state.timerTargetEnd) return;
  const root = document.getElementById('timer-overlay');
  if (!root) return;

  const msLeft = state.timerTargetEnd - Date.now();
  const remaining = Math.max(0, Math.ceil(msLeft / 1000));
  const over = Math.max(0, Math.floor(-msLeft / 1000));
  state.timerRemaining = remaining;
  const done = msLeft <= 0;
  const p = timerProgress();

  root.querySelectorAll('.js-time').forEach(el => { el.textContent = formatTime(remaining); });

  let next;
  if (done) next = over >= 2 ? `перестаивает  +${formatTime(over)}` : 'время вышло';
  else next = state.timerNextPlanned ? `дальше ${formatTime(state.timerNextPlanned)}` : 'последний пролив';
  root.querySelectorAll('.js-next').forEach(el => { el.textContent = next; });

  const status = document.getElementById('t-status');
  if (status) {
    status.textContent = done ? 'Пора сливать'
      : p < 0.4 ? 'Настой раскрывается'
      : p < 0.8 ? 'Набирает силу'
      : 'Почти готово';
  }

  const pourBtn = document.getElementById('btn-pour');
  if (done && !root.classList.contains('is-done')) {
    root.classList.add('is-done');
    if (pourBtn) pourBtn.textContent = 'Слить!';
  }

  if (done && !state.timerNotified) {
    state.timerNotified = true;
    timerFinished();
    startRepeatAlerts();
  }
}


// ============================================
// Надёжные напоминания
// ============================================
// 1) «Будильник» живёт отдельно от экрана таймера — сработает, даже если вы ушли в историю
// 2) пока заварка не слита — повторяем сигнал
// 3) тихий звук в фоне не даёт браузеру усыпить вкладку (по желанию, в настройках)
function armAlarm() {
  disarmAlarm();
  if (!state.timerTargetEnd) return;
  const ms = Math.max(0, state.timerTargetEnd - Date.now()) + 40;
  state.alarmTimeout = setTimeout(onAlarm, ms);
}
function disarmAlarm() {
  if (state.alarmTimeout) { clearTimeout(state.alarmTimeout); state.alarmTimeout = null; }
  stopRepeatAlerts();
  hideReadyToast();
}
function onAlarm() {
  if (!state.timerTargetEnd) return;
  if (!state.timerNotified) { state.timerNotified = true; timerFinished(); }
  startRepeatAlerts();
  if (state.currentScreen !== 'timer') showReadyToast();
}
function startRepeatAlerts() {
  stopRepeatAlerts();
  if (!state.settings || !state.settings.repeat_alert) return;
  let n = 0;
  state.repeatAlertTimer = setInterval(() => {
    if (!state.timerTargetEnd || ++n > 8) { stopRepeatAlerts(); return; }
    if (state.settings.sound_enabled) playReminder();
    if (state.settings.vibration_enabled && navigator.vibrate) navigator.vibrate([160, 90, 160]);
    notifyBrewReady();
  }, 30000);
  if (!state._origTitle) state._origTitle = document.title;
  document.title = '🍵 Пора сливать!';
}
function stopRepeatAlerts() {
  if (state.repeatAlertTimer) { clearInterval(state.repeatAlertTimer); state.repeatAlertTimer = null; }
  if (state._origTitle) { document.title = state._origTitle; state._origTitle = null; }
}
function showReadyToast() {
  hideReadyToast();
  const t = document.createElement('button');
  t.id = 'ready-toast'; t.className = 'ready-toast';
  t.innerHTML = '<span>🍵</span><b>Пролив готов</b><em>Вернуться к таймеру</em>';
  t.onclick = () => { hideReadyToast(); navigate('timer'); };
  document.getElementById('app').appendChild(t);
}
function hideReadyToast() { const t = document.getElementById('ready-toast'); if (t) t.remove(); }

// Тихая петля (WAV с тишиной) + MediaSession: Android/iOS не замораживают страницу
const SILENT_WAV = 'data:audio/wav;base64,UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAABErAAABAAgAZGF0YQAAAAA=';
function startKeepAlive() {
  if (!state.settings || !state.settings.bg_keepalive) return;
  try {
    if (!state.keepAliveAudio) {
      const a = new Audio(SILENT_WAV);
      a.loop = true; a.volume = 0.02; a.preload = 'auto';
      state.keepAliveAudio = a;
    }
    state.keepAliveAudio.play().catch(() => {});
    if ('mediaSession' in navigator && window.MediaMetadata) {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: (state.currentSession && state.currentSession.tea_name_snapshot) || 'TeaTimer',
        artist: state.timerCount || 'Заварка идёт',
        album: 'TeaTimer'
      });
    }
  } catch (e) { /* не критично */ }
}
function stopKeepAlive() {
  try {
    if (state.keepAliveAudio) state.keepAliveAudio.pause();
    if ('mediaSession' in navigator) navigator.mediaSession.metadata = null;
  } catch (e) { /* ignore */ }
}

async function testAlert() {
  if (state.settings.sound_enabled) playGong();
  if (state.settings.vibration_enabled && navigator.vibrate) navigator.vibrate([200, 100, 400]);
  if ('Notification' in window && Notification.permission === 'default') await Notification.requestPermission();
  if ('Notification' in window && Notification.permission === 'granted') {
    try {
      const reg = 'serviceWorker' in navigator ? await navigator.serviceWorker.getRegistration() : null;
      const opts = { body: 'Так будет выглядеть напоминание о проливе', icon: 'assets/TeaTimer.png', tag: 'teatimer-test' };
      if (reg && reg.showNotification) await reg.showNotification('TeaTimer 🍵', opts); else new Notification('TeaTimer 🍵', opts);
    } catch (e) { console.warn(e); }
  }
  const el = document.getElementById('alert-state');
  if (el) el.textContent = alertStateText();
}
function alertStateText() {
  if (!('Notification' in window)) return 'уведомления не поддерживаются';
  return { granted: 'уведомления разрешены', denied: 'уведомления запрещены в браузере', default: 'разрешение ещё не выдано' }[Notification.permission];
}

function timerFinished() {
  if (state.settings.sound_enabled) playGong();
  if (state.settings.vibration_enabled && navigator.vibrate) {
    navigator.vibrate([200, 100, 400]);
  }
  notifyBrewReady();
}

// На Android Chrome `new Notification()` бросает исключение — нужен showNotification через SW.
// Показываем только если приложение свёрнуто: на экране и так видно «Пора сливать».
async function notifyBrewReady() {
  try {
    if (!('Notification' in window) || Notification.permission !== 'granted') return;
    if (!document.hidden && state.currentScreen === 'timer') return;
    const opts = {
      body: 'Пролив готов — сливайте чай',
      icon: 'assets/TeaTimer.png',
      badge: 'assets/TeaTimer.png',
      tag: 'teatimer-ready',
      renotify: true,
      vibrate: [200, 100, 400]
    };
    const reg = 'serviceWorker' in navigator ? await navigator.serviceWorker.getRegistration() : null;
    if (reg && reg.showNotification) await reg.showNotification('TeaTimer 🍵', opts);
    else new Notification('TeaTimer 🍵', opts);
  } catch (e) { console.warn('Notification failed', e); }
}

// Вернулись в приложение — сразу догоняем время и возвращаем wake lock
document.addEventListener('visibilitychange', () => {
  if (document.hidden || !state.timerTargetEnd) return;
  if (state.currentScreen !== 'timer') { if (state.timerTargetEnd <= Date.now()) { onAlarm(); } return; }
  updateTimerDisplay();
  if (state.timerRunning && state.settings && state.settings.keep_screen_on && !state.wakeLock) requestWakeLock();
});

// Напоминание «слейте чай» — отдельный звук, не такой, как гонг окончания пролива
function playReminder() {
  const id = (state.settings && state.settings.reminder_sound) || 'bell-sound';
  const audio = document.getElementById(id) || document.getElementById('bell-sound');
  if (audio) { audio.currentTime = 0; audio.play().catch(() => {}); }
}
