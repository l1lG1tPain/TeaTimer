}

// Конец всей церемонии (после последнего слива) — «Мягкий звон»
function playCeremonyEnd() {
  if (state.settings && state.settings.sound_enabled) {
    const a = document.getElementById('soft-ring-sound');
    if (a) { a.currentTime = 0; a.play().catch(() => {}); }
  }
  if (state.settings && state.settings.vibration_enabled && navigator.vibrate) navigator.vibrate([120, 80, 120, 80, 240]);
}

function playGong() {
  const audio = document.getElementById('gong-sound');
  if (audio) {
    audio.currentTime = 0;
    audio.play().catch(() => {});
  }
}

function pourTea() {
  const session = state.currentSession;
  if (!session) return;
  const idx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (idx >= 0) {
    const inf = session.infusion_log[idx];
    // + = передержка, − = слили раньше времени
    const delta = state.timerTargetEnd ? (Date.now() - state.timerTargetEnd) / 1000 : 0;
    inf.poured_at = new Date().toISOString();
    inf.actual_seconds = Math.max(1, Math.round(inf.planned_seconds + delta));
    inf.overtime_seconds = Math.max(0, Math.round(delta));
    db.saveSession(session);
  }
  stopTimer();
  state.timerTargetEnd = null;
  if (navigator.vibrate && state.settings.vibration_enabled) navigator.vibrate(14);
  const nextIdx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (nextIdx >= 0) {
    renderTimer();
  } else {
    finishSession();
  }
}

function skipInfusion() {
  const session = state.currentSession;
  if (!session) return;
  const idx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (idx >= 0) {
    session.infusion_log[idx].skipped = true;
    db.saveSession(session);
  }
  stopTimer();
  state.timerTargetEnd = null;
  const nextIdx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (nextIdx >= 0) {
    renderTimer();
  } else {
    finishSession();
  }
}

async function finishSession() {
  stopTimer();
  state.timerTargetEnd = null;
  const session = state.currentSession;
  let sheetId = null;
  if (session && !session.end_time) {
    if (sessionPours(session) === 0) {
      // Ничего не слили — запись не нужна
      await db.deleteSession(session.id);
    } else {
      session.end_time = new Date().toISOString();
      await db.saveSession(session);
      sheetId = session.id;
    }
    state.sessions = await db.getSessions();
  }
  state.currentSession = null;
  if (sheetId) playCeremonyEnd();
  navigate('history');
  if (sheetId) setTimeout(() => openSessionSheet(sheetId, { justFinished: true }), 350);
}

// Wake Lock
async function requestWakeLock() {
  try {
    if ('wakeLock' in navigator) {
      state.wakeLock = await navigator.wakeLock.request('screen');
    }
  } catch (e) { console.warn('Wake lock failed', e); }
}

function releaseWakeLock() {
  if (state.wakeLock) {
    state.wakeLock.release().catch(() => {});
    state.wakeLock = null;
  }
}

