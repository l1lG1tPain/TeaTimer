      ${presets.length ? `
      <span class="overline">Мои сценарии</span>
      <div class="cs-presets">
        ${presets.map(p => `
          <span class="cs-preset"><button onclick="loadPreset('${p.id}')">${escapeHtml(p.name)}<em>${p.times.length} пр.</em></button><button class="x" onclick="deletePreset('${p.id}')" aria-label="Удалить сценарий">×</button></span>
        `).join('')}
      </div>` : ''}

      <div class="cs-tools">
        <button class="btn-secondary" onclick="resetCustomScenario()">↺ Как рекомендуем</button>
        <div class="cs-shift"><span>Сдвиг</span><button onclick="shiftAll(-5)">−5</button><button onclick="shiftAll(5)">+5</button></div>
