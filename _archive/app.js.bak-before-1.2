async function copyTeaName(id, btn) {
  const t = getTea(id); if (!t) return;
  const text = t.name_ru;
  let ok = false;
  try { await navigator.clipboard.writeText(text); ok = true; } catch (e) {
    try {
      const ta = document.createElement('textarea'); ta.value = text; ta.style.cssText = 'position:fixed;opacity:0;top:0;left:0';
      document.body.appendChild(ta); ta.select(); ok = document.execCommand('copy'); ta.remove();
    } catch (e2) { ok = false; }
  }
  if (btn && ok) {
    const old = btn.innerHTML;
    btn.classList.add('done');
    btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    setTimeout(() => { btn.classList.remove('done'); btn.innerHTML = old; }, 1400);
  }
  if (navigator.vibrate) navigator.vibrate(8);
  showToast(ok ? 'Название скопировано' : 'Не удалось скопировать');
}

function teaRatingPanel(teaId) {
  const mine = RatingService.teaRating(teaId);
  const st = RatingService.sessionStats(teaId);
  const sub = st.count
    ? `по чаепитиям ★ ${st.avg.toFixed(1)} · ${st.count} ${plural(st.count, 'оценка', 'оценки', 'оценок')}`
    : 'пока без чаепитий';
  return `
    <div class="panel rate-panel mt-16">
      <div class="rp-head"><span class="overline">Мой рейтинг</span><span class="rp-sub">${sub}</span></div>
      <div class="rp-stars" id="tea-stars">
        ${[1, 2, 3, 4, 5].map(n => `<button class="${mine >= n ? 'on' : ''}" onclick="rateTea('${teaId}', ${n})" aria-label="${n} из 5">★</button>`).join('')}
      </div>
      <div class="rp-foot">${mine ? ['', 'Не зашёл', 'Так себе', 'Нормальный', 'Хороший', 'Любимый!'][mine] : 'Нажмите на звезду, чтобы оценить'}<em>Общий рейтинг — скоро</em></div>
    </div>`;
}

async function rateTea(teaId, n) {
  const next = RatingService.teaRating(teaId) === n ? 0 : n;
  await RatingService.setTeaRating(teaId, next);
  const host = document.getElementById('tea-stars');
  if (host) host.querySelectorAll('button').forEach((el, i) => el.classList.toggle('on', i < next));
  const foot = document.querySelector('.rp-foot');
  if (foot) foot.firstChild.textContent = next ? ['', 'Не зашёл', 'Так себе', 'Нормальный', 'Хороший', 'Любимый!'][next] : 'Нажмите на звезду, чтобы оценить';
  if (navigator.vibrate && state.settings.vibration_enabled) navigator.vibrate(8);
}

async function toggleTeaFavorite(teaId) {
  const isFav = await db.toggleFavorite(teaId);
  if (isFav) state.favorites.push(teaId);
  else state.favorites = state.favorites.filter(id => id !== teaId);
  renderTeaDetail(teaId);
}

