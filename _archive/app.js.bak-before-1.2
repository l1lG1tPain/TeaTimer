      </button>

      ${backupDue() ? `
      <div class="backup-banner mt-20">
        <div><b>Сохраните копию данных</b><span>История и оценки хранятся только в этом браузере</span></div>
        <div class="bb-actions"><button class="btn-primary sm" onclick="exportData()">Сохранить</button><button class="btn-secondary sm" onclick="snoozeBackup()">Позже</button></div>
      </div>` : ''}

      <div style="margin-top: 20px; display:flex;flex-direction:column;gap:12px;">
        <span class="overline">Что заварить сегодня</span>
        <div id="today-card" class="today-card">${todayCardHtml()}</div>
      </div>

      <div style="margin-top: 20px; display:flex;flex-direction:column;gap:12px;">
        <span class="overline">Под рукой</span>
