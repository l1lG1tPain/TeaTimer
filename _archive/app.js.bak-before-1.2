// ============================================
// Screen: Catalog
// ============================================
// ============================================
// Умный поиск: слитно/раздельно, ё/е, латиница ↔ кириллица, опечатки,
// синонимы, теги и слова из описания
// ============================================
const _CYR2LAT = { а:'a',б:'b',в:'v',г:'g',д:'d',е:'e',ж:'zh',з:'z',и:'i',й:'i',к:'k',л:'l',м:'m',н:'n',о:'o',п:'p',р:'r',с:'s',т:'t',у:'u',ф:'f',х:'h',ц:'c',ч:'ch',ш:'sh',щ:'sh',ы:'i',э:'e',ю:'yu',я:'ya' };
const _SEARCH_SYN = [
  [/^(пуер|пуэр|пу|puer|puerh)$/, 'пуэр'], [/^(олонг|олун|улонг|улун|oolong|ulong|wulong)$/, 'улун'],
  [/^(чорн|черн|black)\w*$/, 'красн'], [/^(зелен|green)\w*$/, 'зелен'], [/^(белы|бела|white)\w*$/, 'бел'],
  [/^(жасмин|jasmine|моли)\w*$/, 'жасмин'], [/^(молочн|milk)\w*$/, 'молочн'], [/^(дикорос|дики)\w*$/, 'дик']
];

function sNorm(str) {
  return String(str || '').toLowerCase().replace(/ё/g, 'е').replace(/[ьъ’'`´"«»]/g, '').replace(/й/g, 'и')
    .replace(/(.)\1+/g, '$1').replace(/[^a-z0-9а-я㐀-鿿\s]/g, ' ').replace(/\s+/g, ' ').trim();
}
const sKey = str => sNorm(str).replace(/\s/g, '');
function cyr2lat(k) {
  return k.replace(/чж/g, 'zh').replace(/цз/g, 'z').replace(/[а-я]/g, c => _CYR2LAT[c] || c).replace(/(.)\1+/g, '$1');
}
function lat2cyr(k) {
  return k.replace(/ong|ung/g, 'ун').replace(/ing/g, 'ин').replace(/ang/g, 'ан').replace(/eng/g, 'эн')
    .replace(/zh/g, 'чж').replace(/ch/g, 'ч').replace(/sh/g, 'ш').replace(/yu/g, 'ю').replace(/ya/g, 'я').replace(/yi/g, 'и')
    .replace(/[a-z]/g, c => ({a:'а',b:'б',c:'ц',d:'д',e:'е',f:'ф',g:'г',h:'х',i:'и',j:'ц',k:'к',l:'л',m:'м',n:'н',o:'о',p:'п',q:'ч',r:'р',s:'с',t:'т',u:'у',v:'в',w:'в',x:'с',y:'и',z:'з'}[c])).replace(/(.)\1+/g, '$1');
}
// «Фонетический» ключ: латиница к кириллице-упрощённой, чтобы «hong» ≈ «хун», «Bai» ≈ «бай»
function sPhon(k) { return /[a-z]/.test(k) ? lat2cyr(k) : k; }

// Минимальное расстояние от запроса до любой подстроки текста (опечатки)
function approxSub(q, text, maxD) {
  const m = q.length, n = text.length;
  if (!m || !n) return 99;
  let prev = new Array(n + 1).fill(0), cur = new Array(n + 1);
  for (let i = 1; i <= m; i++) {
    cur[0] = i;
    for (let j = 1; j <= n; j++) {
      const c = q[i - 1] === text[j - 1] ? 0 : 1;
      cur[j] = Math.min(prev[j - 1] + c, prev[j] + 1, cur[j - 1] + 1);
    }
    [prev, cur] = [cur, prev];
  }
  let best = 99;
  for (let j = 0; j <= n; j++) if (prev[j] < best) best = prev[j];
  return best <= maxD ? best : 99;
}

function teaSearchIndex(tea) {
  if (tea._si && tea._siSrc === tea.description_ru + '|' + tea.name_ru) return tea._si;
  const cat = getCategory(tea.category) || {};
  const names = [tea.name_ru, tea.name_en, tea.name_cn].concat(tea.aliases || []).filter(Boolean);
  const nameKeys = [];
  names.forEach(n => {
    const k = sKey(n); if (!k) return;
    nameKeys.push(k, sPhon(k), cyr2lat(k));
    // отдельные слова названия тоже ищутся (Хун, Пао…)
  });
  const words = names.flatMap(n => sNorm(n).split(' ')).filter(w => w.length > 1);
  const wordKeys = words.flatMap(w => [w, sPhon(w), cyr2lat(w)]);
  const tagWords = (tea.tags || []).flatMap(t => sNorm(t).split(' ')).filter(w => w.length > 1);
  const catWords = sNorm([cat.name_ru, cat.name_cn, cat.hint_ru, cat.name_en].filter(Boolean).join(' ')).split(' ').filter(w => w.length > 1);
  const descWords = sNorm(tea.description_ru || '').split(' ').filter(w => w.length > 2);
  const hasCn = /[㐀-鿿]/.test(names.join(''));
  tea._si = { nameKeys: [...new Set(nameKeys)], wordKeys: [...new Set(wordKeys)], tagWords, catWords, descWords, cn: names.filter(n => /[㐀-鿿]/.test(n)).join(''), hasCn };
  tea._siSrc = tea.description_ru + '|' + tea.name_ru;
  return tea._si;
}

function stemOf(w) { return w.length >= 6 ? w.slice(0, w.length - 2) : (w.length === 5 ? w.slice(0, 4) : w); }

// Оценка одного слова запроса по чаю: чем выше — тем лучше, 0 — не подошло
function scoreToken(tok, si) {
  let best = 0;
  const forms = [...new Set([tok, sPhon(tok), cyr2lat(tok)])];
  if (/[㐀-鿿]/.test(tok)) return si.cn.includes(tok) ? 95 : 0;
  for (const f of forms) {
    if (f.length < 2) continue;
    for (const nk of si.wordKeys) {
      if (nk === f) best = Math.max(best, 100);
      else if (nk.startsWith(f)) best = Math.max(best, 88);
      else if (f.length >= 3 && nk.includes(f)) best = Math.max(best, 70);
    }
    if (best >= 100) return best;
    for (const nk of si.nameKeys) {
      if (nk === f) best = Math.max(best, 100);
      else if (nk.startsWith(f)) best = Math.max(best, 92);
      else if (nk.includes(f)) best = Math.max(best, 78);
    }
  }
  if (best) return best;
  const st = stemOf(tok);
  if (tok.length >= 3) {
    if (si.tagWords.some(w => w.startsWith(st))) best = Math.max(best, 72);
    if (si.catWords.some(w => w.startsWith(st))) best = Math.max(best, 86);
    if (si.descWords.some(w => w.startsWith(st))) best = Math.max(best, 34);
  }
  if (best) return best;
  // опечатки: допускаем 1 ошибку для 4–6 букв и 2 для длинных
  const d = tok.length >= 7 ? 2 : (tok.length >= 4 ? 1 : 0);
  if (d) {
    for (const f of forms) {
      for (const nk of si.nameKeys) {
        const dist = approxSub(f, nk, d);
        if (dist <= d) best = Math.max(best, 66 - dist * 8);
      }
    }
    if (!best) {
      for (const w of [...si.tagWords, ...si.catWords]) {
        const dist = approxSub(tok, w.slice(0, tok.length + 1), d);
        if (dist <= d) best = Math.max(best, 40 - dist * 6);
      }
    }
  }
  return best;
}

function teaSearchScore(tea, qNorm, qKey) {
  const si = teaSearchIndex(tea);
  let tokens = qNorm.split(' ').filter(Boolean);
  _SEARCH_SYN.forEach(([re, to]) => { tokens = tokens.map(t => t.replace(re, to)); });
  // 1) весь запрос как одно слово (слитное написание «дахунпао», «бай му дань»)
  let whole = 0;
  const forms = [...new Set([qKey, sPhon(qKey), cyr2lat(qKey)])];
  if (qKey.length >= 3 && !/[㐀-鿿]/.test(qKey)) {
    for (const f of forms) {
      for (const nk of si.nameKeys) {
        if (nk === f) whole = Math.max(whole, 130);
        else if (nk.startsWith(f)) whole = Math.max(whole, 112);
        else if (nk.includes(f)) whole = Math.max(whole, 95);
        else {
          const d = f.length >= 8 ? 2 : (f.length >= 5 ? 1 : 0);
          if (d) { const dist = approxSub(f, nk, d); if (dist <= d) whole = Math.max(whole, 80 - dist * 10); }
        }
      }
    }
  }
  // 2) по словам запроса: все должны найтись
  let sum = 0, ok = tokens.length > 0;
  for (const t of tokens) {
    const sc = scoreToken(t, si);
    if (!sc) { ok = false; break; }
    sum += sc;
  }
  const byTok = ok ? sum / tokens.length + Math.min(10, tokens.length * 3) : 0;
  return Math.max(whole, byTok);
}

function catalogFiltered() {
  const qNorm = sNorm(state.searchQuery);
  let list = TEAS;
  if (state.activeCategory !== 'all') list = list.filter(t => t.category === state.activeCategory);
  if (!qNorm) return list;
  const qKey = qNorm.replace(/\s/g, '');
  return list
    .map(t => ({ t, sc: teaSearchScore(t, qNorm, qKey) }))
    .filter(x => x.sc > 0)
    .sort((a, b) => b.sc - a.sc)
    .map(x => x.t);
}

function catalogListHtml() {
  const filtered = catalogFiltered();
  if (!filtered.length) return '<div class="empty-state"><p class="font-display">Ничего не найдено</p><span>Попробуйте другое название или сбросьте фильтр</span></div>';
  return '<div class="panel flush">' + filtered.map(tea => {
    const cat = getCategory(tea.category);
    return `
      <div class="list-row" onclick="navigate('tea-detail', {teaId:'${tea.id}'})">
        <span class="gem" style="--c:${cat.accent}"></span>
        <div class="row-content">
