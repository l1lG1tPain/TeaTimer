function catalogFiltered() {
  const q = state.searchQuery.toLowerCase().trim();
  let list = TEAS;
  if (state.activeCategory !== 'all') list = list.filter(t => t.category === state.activeCategory);
  if (q) {
    list = list.filter(t =>
      (t.name_ru && t.name_ru.toLowerCase().includes(q)) ||
      (t.name_en && t.name_en.toLowerCase().includes(q)) ||
      (t.name_cn && t.name_cn.includes(q)) ||
      (t.tags && t.tags.some(tag => tag.toLowerCase().includes(q)))
    );
  }
  return list;
}

function catalogListHtml() {
  const filtered = catalogFiltered();
  if (!filtered.length) return '<div class="empty-state"><p class="font-display">Ничего не найдено</p><span>Попробуйте другое название или сбросьте фильтр</span></div>';
  return '<div class="panel flush">' + filtered.map(tea => {
    const cat = getCategory(tea.category);
    return `
      <div class="list-row" onclick="navigate('tea-detail', {teaId:'${tea.id}'})">
        <span class="gem" style="--c:${cat.accent}"></span>
        <div class="row-content">
          <span class="row-title">${escapeHtml(tea.name_ru)}</span>
          <span class="row-meta">${escapeHtml(tea.name_cn)} · ${cat.name_ru} · ${tea.temperature_min}–${tea.temperature_max}°C</span>
        </div>
        ${ratingBadge(tea.id)}
        <span class="row-badge">${tea.max_infusions} пр.</span>
      </div>`;
  }).join('') + '</div>';
}

