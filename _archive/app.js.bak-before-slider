// ---- Таймер: логика ----
const TIMER_TICKS = 40;
const WAVE_TILE = { front: 120, back: 170 };
const REDUCED_MOTION = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;

function hexToRgb(hex) {
  const n = parseInt(hex.replace('#', ''), 16);
  return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
}
function _lin(c) { c /= 255; return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4); }
function _lum([r, g, b]) { return 0.2126 * _lin(r) + 0.7152 * _lin(g) + 0.0722 * _lin(b); }
// Тёмный или светлый текст читается лучше на этом цвете настоя?
function contrastText(rgb) {
  const L = _lum(rgb);
  const dark = _lum([30, 27, 21]), light = _lum([253, 248, 235]);
  const cDark = (L + 0.05) / (dark + 0.05);
  const cLight = (light + 0.05) / (L + 0.05);
  return cDark >= cLight ? '#1E1B15' : '#FDF8EB';
}

// Прогресс 0..1 по реальному времени (не зависит от тиков интервала)
function timerProgress() {
  if (!state.timerTargetEnd || !state.timerTotal) return 0;
  const left = (state.timerTargetEnd - Date.now()) / 1000;
  return Math.min(1, Math.max(0, 1 - left / state.timerTotal));
}

function startTimer(seconds) {
  stopTimer();
  state.timerTotal = seconds;
  if (!state.timerTargetEnd) {           // новый пролив
    state.timerTargetEnd = Date.now() + seconds * 1000;
    state.timerNotified = false;
  }
  state.timerRunning = true;

  if (state.settings.keep_screen_on) requestWakeLock();

  updateTimerDisplay();
  // Интервал живёт и после конца — считает «перестой»
  state.timerInterval = setInterval(updateTimerDisplay, 1000);
  // Точный выстрел ровно в конец (интервал может «поплыть» в фоне)
  const ms = Math.max(0, state.timerTargetEnd - Date.now()) + 30;
  state.timerEndTimeout = setTimeout(updateTimerDisplay, ms);
  startTimerFrames();
}

function stopTimerLoops() {
  if (state.timerInterval) { clearInterval(state.timerInterval); state.timerInterval = null; }
  if (state.timerEndTimeout) { clearTimeout(state.timerEndTimeout); state.timerEndTimeout = null; }
  if (state.timerRaf) { cancelAnimationFrame(state.timerRaf); state.timerRaf = null; }
}

function stopTimer() {
  stopTimerLoops();
  state.timerRunning = false;
  releaseWakeLock();
}

// Плавная анимация: уровень настоя, волны, тики, «энергия»
function startTimerFrames() {
  const root = document.getElementById('timer-overlay');
  const vessel = document.getElementById('vessel');
  const front = document.getElementById('liquid-front');
  const back = document.getElementById('liquid-back');
  const ticks = root ? root.querySelectorAll('#t-ticks line') : [];
  if (!root || !vessel || !front || !back) return;

  let last = performance.now();
  let pa = Math.random() * WAVE_TILE.front;
  let pb = Math.random() * WAVE_TILE.back;
  let lastOn = -1, lastEnergy = -1;

  const frame = (now) => {
    if (!document.getElementById('timer-overlay')) { state.timerRaf = null; return; }
    state.timerRaf = requestAnimationFrame(frame);

    const dt = Math.min(0.1, (now - last) / 1000);
    last = now;

    const p = timerProgress();
    const level = 0.08 + 0.86 * p;                     // кружка никогда не «переполнена» до краёв
    vessel.style.setProperty('--p', level.toFixed(4));

    // Чем ближе конец — тем «кипучее»
    const energy = 0.35 + 0.65 * Math.pow(p, 1.4);
    if (Math.abs(energy - lastEnergy) > 0.01) {
      root.style.setProperty('--energy', energy.toFixed(3));
      lastEnergy = energy;
    }

    if (!REDUCED_MOTION) {
      const speed = 18 + energy * 62;                  // px/с
      pa = (pa + dt * speed) % WAVE_TILE.front;
      pb = (pb - dt * speed * 0.62 + WAVE_TILE.back) % WAVE_TILE.back;
      front.style.setProperty('--wx', (-pa).toFixed(1) + 'px');
      back.style.setProperty('--wx', (-pb).toFixed(1) + 'px');
    }

    const on = Math.floor(p * TIMER_TICKS);
    if (on !== lastOn) {
      ticks.forEach((t, i) => {
        t.classList.toggle('on', i < on);
        t.classList.toggle('head', i === on && p < 1);
      });
      lastOn = on;
    }
  };
  state.timerRaf = requestAnimationFrame(frame);
}

function updateTimerDisplay() {
  if (!state.timerTargetEnd) return;
  const root = document.getElementById('timer-overlay');
  if (!root) return;

  const msLeft = state.timerTargetEnd - Date.now();
  const remaining = Math.max(0, Math.ceil(msLeft / 1000));
  const over = Math.max(0, Math.floor(-msLeft / 1000));
  state.timerRemaining = remaining;
  const done = msLeft <= 0;
  const p = timerProgress();

  root.querySelectorAll('.js-time').forEach(el => { el.textContent = formatTime(remaining); });

  let next;
  if (done) next = over >= 2 ? `перестаивает  +${formatTime(over)}` : 'время вышло';
  else next = state.timerNextPlanned ? `дальше ${formatTime(state.timerNextPlanned)}` : 'последний пролив';
  root.querySelectorAll('.js-next').forEach(el => { el.textContent = next; });

  const status = document.getElementById('t-status');
  if (status) {
    status.textContent = done ? 'Пора сливать'
      : p < 0.4 ? 'Настой раскрывается'
      : p < 0.8 ? 'Набирает силу'
      : 'Почти готово';
  }

  const pourBtn = document.getElementById('btn-pour');
  if (done && !root.classList.contains('is-done')) {
    root.classList.add('is-done');
    if (pourBtn) pourBtn.textContent = 'Слить!';
  }

  if (done && !state.timerNotified) {
    state.timerNotified = true;
    timerFinished();
  }
}

function timerFinished() {
  if (state.settings.sound_enabled) playGong();
  if (state.settings.vibration_enabled && navigator.vibrate) {
    navigator.vibrate([200, 100, 400]);
  }
  notifyBrewReady();
}

// На Android Chrome `new Notification()` бросает исключение — нужен showNotification через SW.
// Показываем только если приложение свёрнуто: на экране и так видно «Пора сливать».
async function notifyBrewReady() {
  try {
    if (!('Notification' in window) || Notification.permission !== 'granted') return;
    if (!document.hidden) return;
    const opts = {
      body: 'Пролив готов — сливайте чай',
      icon: 'assets/TeaTimer.png',
      badge: 'assets/TeaTimer.png',
      tag: 'teatimer-ready',
      renotify: true,
      vibrate: [200, 100, 400]
    };
    const reg = 'serviceWorker' in navigator ? await navigator.serviceWorker.getRegistration() : null;
    if (reg && reg.showNotification) await reg.showNotification('TeaTimer 🍵', opts);
    else new Notification('TeaTimer 🍵', opts);
  } catch (e) { console.warn('Notification failed', e); }
}

// Вернулись в приложение — сразу догоняем время и возвращаем wake lock
document.addEventListener('visibilitychange', () => {
  if (document.hidden || state.currentScreen !== 'timer' || !state.timerTargetEnd) return;
  updateTimerDisplay();
  if (state.timerRunning && state.settings && state.settings.keep_screen_on && !state.wakeLock) requestWakeLock();
});

function playGong() {
  const audio = document.getElementById('gong-sound');
  if (audio) {
    audio.currentTime = 0;
    audio.play().catch(() => {});
  }
}

function pourTea() {
  const session = state.currentSession;
  if (!session) return;
  const idx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (idx >= 0) {
    const inf = session.infusion_log[idx];
    // + = передержка, − = слили раньше времени
    const delta = state.timerTargetEnd ? (Date.now() - state.timerTargetEnd) / 1000 : 0;
    inf.poured_at = new Date().toISOString();
    inf.actual_seconds = Math.max(1, Math.round(inf.planned_seconds + delta));
    inf.overtime_seconds = Math.max(0, Math.round(delta));
    db.saveSession(session);
  }
  stopTimer();
  state.timerTargetEnd = null;
  if (navigator.vibrate && state.settings.vibration_enabled) navigator.vibrate(14);
  const nextIdx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (nextIdx >= 0) {
    renderTimer();
  } else {
    finishSession();
  }
}

function skipInfusion() {
  const session = state.currentSession;
  if (!session) return;
  const idx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (idx >= 0) {
    session.infusion_log[idx].skipped = true;
    db.saveSession(session);
  }
  stopTimer();
  state.timerTargetEnd = null;
  const nextIdx = session.infusion_log.findIndex(i => i.poured_at === null && !i.skipped);
  if (nextIdx >= 0) {
    renderTimer();
  } else {
    finishSession();
  }
}

async function finishSession() {
  stopTimer();
  state.timerTargetEnd = null;
  const session = state.currentSession;
  let sheetId = null;
  if (session && !session.end_time) {
    if (sessionPours(session) === 0) {
      // Ничего не слили — запись не нужна
      await db.deleteSession(session.id);
    } else {
      session.end_time = new Date().toISOString();
      await db.saveSession(session);
      sheetId = session.id;
    }
    state.sessions = await db.getSessions();
  }
  state.currentSession = null;
  navigate('history');
  if (sheetId) setTimeout(() => openSessionSheet(sheetId, { justFinished: true }), 350);
}

// Wake Lock
async function requestWakeLock() {
  try {
    if ('wakeLock' in navigator) {
      state.wakeLock = await navigator.wakeLock.request('screen');
    }
  } catch (e) { console.warn('Wake lock failed', e); }
}

function releaseWakeLock() {
  if (state.wakeLock) {
    state.wakeLock.release().catch(() => {});
    state.wakeLock = null;
  }
}

