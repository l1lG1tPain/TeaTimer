function renderTimer() {
  const container = document.getElementById('screen-timer');
  if (!container) return;

  const session = state.currentSession;
  if (!session) { navigate('home'); return; }

  const tea = getTea(session.tea_id);
  const cat = tea ? getCategory(tea.category) : CATEGORIES[0];
  const log = session.infusion_log;
  const currentIdx = log.findIndex(i => i.poured_at === null && !i.skipped);
  const currentInfusion = currentIdx >= 0 ? log[currentIdx] : null;

  if (!currentInfusion) {
    finishSession();
    return;
  }

  const planned = currentInfusion.planned_seconds;
  const totalInfusions = log.length;
  const timeStr = new Date().getHours() + ':' + String(new Date().getMinutes()).padStart(2, '0');

  // Цвета сорта
  const accent = cat.accent;
  const deep = adjustColor(accent, -48);
  const lite = adjustColor(accent, 48);
  const [ar, ag, ab] = hexToRgb(accent);
  const mid = hexToRgb(adjustColor(accent, -24));
  const onLiquid = contrastText(mid);

  // Сколько осталось (если вернулись на экран таймера)
  const remaining = state.timerTargetEnd
    ? Math.max(0, Math.ceil((state.timerTargetEnd - Date.now()) / 1000))
    : planned;

  const nextPlanned = log[currentIdx + 1] ? log[currentIdx + 1].planned_seconds : null;
  state.timerNextPlanned = nextPlanned;
