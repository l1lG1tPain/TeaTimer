}

.hero-btn .title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 600;
  font-size: 32px;
  line-height: 1;
}

.hero-btn .subtitle {
  font-family: 'Karla', sans-serif;
  font-weight: 500;
  font-size: 14px;
