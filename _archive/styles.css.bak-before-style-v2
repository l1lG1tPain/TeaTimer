/* ============================================
   Settings
   ============================================ */
.settings-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--border-light);
}

.settings-row .label {
  font-family: 'Karla', sans-serif;
  font-weight: 400;
  font-size: 18px;
  line-height: 1.2;
  color: var(--text-primary);
}

.settings-row .sublabel {
  font-family: 'Karla', sans-serif;
  font-weight: 400;
  font-size: 13px;
  line-height: 1.3;
  color: var(--text-tertiary);
}

/* ============================================
   Home Screen Specific
   ============================================ */
.hero-btn {
  width: 100%;
  border: none;
  height: 120px;
  border-radius: 28px;
  background: var(--accent-green);
