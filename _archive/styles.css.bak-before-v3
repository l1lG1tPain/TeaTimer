  justify-content: space-between;
  align-items: baseline;
}

.session-card .header .title {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 500;
  font-size: 20px;
  line-height: 1.2;
  color: var(--text-primary);
}

.session-card .header .rating {
  font-family: 'Karla', sans-serif;
  font-weight: 400;
  font-size: 15px;
  color: var(--accent-amber);
}

.session-card .meta {
  display: flex;
  gap: 16px;
  font-family: 'Karla', sans-serif;
  font-weight: 500;
  font-size: 13px;
  color: var(--text-tertiary);
}

.session-card .chart {
  display: flex;
  gap: 4px;
  align-items: flex-end;
  height: 44px;
}

.session-card .chart .bar {
  flex: 1;
  background: var(--chart-bar);
  border-radius: 4px;
