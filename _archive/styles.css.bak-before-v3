  border-bottom: 1px solid var(--border-light);
}

.settings-row .label {
  font-family: 'Karla', sans-serif;
  font-weight: 400;
  font-size: 18px;
  line-height: 1.2;
  color: var(--text-primary);
}

.settings-row .sublabel {
  font-family: 'Karla', sans-serif;
  font-weight: 400;
  font-size: 13px;
  line-height: 1.3;
  color: var(--text-tertiary);
}

