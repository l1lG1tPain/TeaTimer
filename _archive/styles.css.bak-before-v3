}

.history-row .time {
  font-family: 'Karla', sans-serif;
  font-weight: 500;
  font-size: 13px;
  color: var(--text-tertiary);
  width: 44px;
  flex-shrink: 0;
}

.history-row .name {
  flex: 1;
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 500;
  font-size: 18px;
  line-height: 1.2;
  color: var(--text-primary);
}

.history-row .info {
  font-family: 'Karla', sans-serif;
  font-weight: 500;
  font-size: 13px;
